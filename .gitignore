# Build-Artefakte - die ISO gehoert nicht ins Repo (~1.8 GB)
output/
*.iso
*.iso.sha256
*.squashfs
build.log

# live-build Arbeitsverzeichnisse, falls lokal gebaut wird
build/lb-config/config/
build/lb-config/.build/
build/lb-config/cache/
build/lb-config/chroot/
build/lb-config/binary/
build/lb-config/local/
build/lb-config/*.log
build/lb-config/*.iso

# temporaere Pruefskripte
scripts/.*.sh
scripts/.*.ps1
scripts/.*.py

# heruntergeladene Pakete und Vorschaubilder aus Testlaeufen
*.deb
*-preview.png

# Ergebnisse des Paketbaus
packages/out/

# GEHEIME SCHLUESSEL - duerfen NIE ins Repository.
# Der private Signierschluessel des APT-Repos liegt als GitHub-Secret
# (APT_SIGNING_KEY). Landet er hier, kann jeder Pakete unter ViperOS-Namen
# signieren und sie wuerden auf allen installierten Systemen als
# vertrauenswuerdig gelten.
*.asc
*.gpg
*.key
*.sec
secring.*
!packages/viperos-settings/usr/share/keyrings/viperos-archive-keyring.gpg

# OS-Kram
Thumbs.db
desktop.ini
.DS_Store

# Quellordner fuer Wallpaper-Uploads; die Bilder liegen bereits unter
# build/lb-config/includes.chroot/usr/share/backgrounds/viperos/
wallpaper-upload/

# Dateien zum Live-Testen in der VM (nicht Teil des Images)
live-test/
