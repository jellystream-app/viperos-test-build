// ViperOS - systemweite fastfetch-Konfiguration
//
// Warum noetig: fastfetch waehlt sein Logo anhand von ID bzw. ID_LIKE aus
// /etc/os-release. "viperos" kennt es nicht (siehe `fastfetch --list-logos`),
// also faellt es auf ID_LIKE=debian zurueck und zeigt das Debian-Logo.
// Ein eigenes ASCII-Logo behebt das.
//
// Dieser Pfad wird von fastfetch durchsucht, bestaetigt ueber
// `fastfetch --list-config-paths`:
//   /root/fastfetch/  /etc/xdg/fastfetch/  /etc/fastfetch/
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "/usr/share/viperos/logo.txt",
    "type": "file",
    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    }
  },

  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    { "type": "os",         "key": "System   " },
    { "type": "kernel",     "key": "Kernel   " },
    { "type": "uptime",     "key": "Laufzeit " },
    { "type": "packages",   "key": "Pakete   " },
    { "type": "shell",      "key": "Shell    " },
    { "type": "de",         "key": "Desktop  " },
    { "type": "wm",         "key": "Fenster  " },
    { "type": "terminal",   "key": "Terminal " },
    { "type": "cpu",        "key": "CPU      " },
    { "type": "gpu",        "key": "Grafik   " },
    { "type": "memory",     "key": "Speicher " },
    { "type": "disk",       "key": "Speicher " },
    "break",
    "colors"
  ]
}
