#!/bin/bash
# ViperosOS - Debian-Branding entfernen
#
# Woher die Debian-Optik kommt:
#
#   desktop-base (483 Dateien, 22 MB) liefert zehn Debian-Themes samt
#   Hintergruenden - ceratopsian, emerald, futureprototype, homeworld,
#   joy, joy-inksplat, lines, moonlight, softwaves, spacefun. Jedes bringt
#   eine eigene XML in /usr/share/gnome-background-properties/ mit, und
#   genau die fuellen die Hintergrund-Auswahl in den Einstellungen.
#
#   Zusaetzlich setzt 10_desktop-base.gschema.override den Standard-
#   Hintergrund auf Debians desktop-background.xml - das ueberschreibt
#   unsere dconf-Vorgabe, weil gschema.override fruehe Prioritaet hat.
#
# desktop-base laesst sich NICHT deinstallieren: gnome-control-center hat
# es als hartes Depends. Also bleibt das Paket, seine Inhalte gehen.
#
# Wichtig: Alles hier passiert VOR Hook 0090 (Cleanup) und NACH 0060
# (Branding), damit die ViperOS-Dateien schon existieren.

set -e

echo "[ViperosOS] Entferne Debian-Branding..."

# ----------------------------------------------------------------------
# 1. Debian-Hintergruende aus der Auswahl nehmen
# ----------------------------------------------------------------------
removed=0
for f in /usr/share/gnome-background-properties/*.xml; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in
        viperos.xml) continue ;;          # unsere eigene behalten
    esac
    rm -f "$f"
    removed=$((removed + 1))
done
echo "  Hintergrund-Kataloge entfernt: $removed"

# Die Bilddaten selbst (22 MB) ebenfalls loeschen.
for d in /usr/share/desktop-base/*-theme; do
    [ -d "$d" ] || continue
    rm -rf "$d"
done
rm -rf /usr/share/images/desktop-base
echo "  Debian-Theme-Verzeichnisse entfernt"

# ----------------------------------------------------------------------
# 2. Die gschema.override neutralisieren
#
# Sie zwingt den Hintergrund auf Debians XML. Statt sie zu loeschen (das
# Paket wuerde sie bei einem Update zurueckbringen) wird sie durch eine
# eigene mit hoeherer Nummer ueberschrieben - 90 gewinnt gegen 10.
# ----------------------------------------------------------------------
cat > /usr/share/glib-2.0/schemas/90_viperos.gschema.override << 'EOF'
[org.gnome.desktop.background]
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/viperos/viperos-slate.jpg'
picture-uri-dark='file:///usr/share/backgrounds/viperos/viperos-slate.jpg'
primary-color='#20232c'
secondary-color='#4a5769'

[org.gnome.desktop.screensaver]
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/viperos/viperos-slate.jpg'
primary-color='#20232c'
secondary-color='#4a5769'

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='blue'
EOF

# Debians Override zusaetzlich leeren, damit sie nichts mehr setzt.
if [ -f /usr/share/glib-2.0/schemas/10_desktop-base.gschema.override ]; then
    : > /usr/share/glib-2.0/schemas/10_desktop-base.gschema.override
    echo "  10_desktop-base.gschema.override geleert"
fi

glib-compile-schemas /usr/share/glib-2.0/schemas/ >/dev/null 2>&1 && \
    echo "  GSettings-Schemata neu kompiliert" || \
    echo "  WARNUNG: glib-compile-schemas fehlgeschlagen"

# ----------------------------------------------------------------------
# 3. Debian-Verknuepfungen aus dem Anwendungsmenue
# ----------------------------------------------------------------------
rm -f /usr/share/applications/debian-homepage.desktop \
      /usr/share/applications/debian-reference.desktop \
      /usr/share/applications/debian-security.desktop \
      /usr/share/desktop-base/debian-homepage.desktop \
      /usr/share/desktop-base/debian-reference.desktop \
      /usr/share/desktop-base/debian-security.desktop
echo "  Debian-Menueeintraege entfernt"

# ----------------------------------------------------------------------
# 4. Logo fuer den GNOME-"Ueber"-Dialog
#
# /etc/os-release verweist mit LOGO=viperos-logo auf ein Icon dieses
# Namens. Ohne passende Datei zeigt der Dialog gar nichts. Debian legt
# sein Pendant unter icons/hicolor/SIZE/places/ ab - dem folgen wir.
# ----------------------------------------------------------------------
if [ -f /usr/share/icons/hicolor/scalable/apps/viperos.svg ]; then
    for size in 64x64 128x128 256x256 scalable; do
        mkdir -p "/usr/share/icons/hicolor/$size/places"
    done
    cp /usr/share/icons/hicolor/scalable/apps/viperos.svg \
       /usr/share/icons/hicolor/scalable/places/viperos-logo.svg
    for size in 64 128 256; do
        src="/usr/share/viperos/user-icon.png"
        [ -f "$src" ] || continue
        if command -v convert >/dev/null 2>&1; then
            convert "$src" -resize "${size}x${size}" \
                "/usr/share/icons/hicolor/${size}x${size}/places/viperos-logo.png" 2>/dev/null || true
        else
            python3 - "$src" "$size" << 'PYEOF' 2>/dev/null || true
import sys
from PIL import Image
src, size = sys.argv[1], int(sys.argv[2])
im = Image.open(src).convert("RGBA").resize((size, size), Image.LANCZOS)
im.save(f"/usr/share/icons/hicolor/{size}x{size}/places/viperos-logo.png")
PYEOF
        fi
    done
    echo "  viperos-logo als Distributions-Icon abgelegt"
fi

# Debian-Embleme entfernen, damit sie nicht in Dialogen auftauchen.
rm -rf /usr/share/icons/desktop-base
find /usr/share/icons/hicolor -name 'emblem-debian*' -delete 2>/dev/null || true

# Icon-Zwischenspeicher neu aufbauen, sonst bleibt das alte Logo sichtbar.
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

# ----------------------------------------------------------------------
# 5. os-release auch unter /usr/lib schreiben
#
# /etc/os-release ist ein Symlink nach ../usr/lib/os-release. "cat >"
# schreibt durch den Symlink, beide Pfade stimmen also bereits ueberein -
# hier nur zur Sicherheit gegenpruefen und melden.
# ----------------------------------------------------------------------
if grep -q 'ViperosOS' /usr/lib/os-release 2>/dev/null; then
    echo "  /usr/lib/os-release traegt ViperOS-Daten"
else
    echo "  WARNUNG: /usr/lib/os-release enthaelt noch Debian-Daten"
    cp /etc/os-release /usr/lib/os-release 2>/dev/null || true
fi

# ----------------------------------------------------------------------
# 6. GRUB-Branding
# ----------------------------------------------------------------------
rm -f /boot/grub/themes/debian* 2>/dev/null || true
if [ -f /etc/default/grub ]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="ViperOS"/' /etc/default/grub
fi

echo "[ViperosOS] Debian-Branding entfernt."
