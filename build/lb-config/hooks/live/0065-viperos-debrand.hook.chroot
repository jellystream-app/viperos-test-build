#!/bin/bash
# ViperosOS - Debian-Branding aus dem Image entfernen
#
# Dieser Hook bleibt bewusst ein Hook und wird NICHT zu einem Paket: er
# LOESCHT Dateien, die ein anderes Paket (desktop-base) mitbringt. Ein Paket,
# das Dateien fremder Pakete entfernt, waere ein Policy-Verstoss - dpkg wuerde
# sie beim naechsten Update von desktop-base ohnehin zurueckbringen. Im
# Image-Bau ist das Loeschen dagegen genau richtig, weil das Ergebnis
# eingefroren wird.
#
# Woher die Debian-Optik kommt:
#
#   desktop-base (483 Dateien, 22 MB) liefert zehn Debian-Themes samt
#   Hintergruenden - ceratopsian, emerald, futureprototype, homeworld, joy,
#   joy-inksplat, lines, moonlight, softwaves, spacefun. Jedes bringt eine
#   eigene XML in /usr/share/gnome-background-properties/ mit, und genau die
#   fuellen die Hintergrund-Auswahl in den Einstellungen.
#
# desktop-base laesst sich NICHT deinstallieren: gnome-control-center hat es
# als hartes Depends. Also bleibt das Paket, seine Inhalte gehen.
#
# Was dieser Hook seit V2 NICHT mehr macht (das liegt in viperos-settings):
#   - 90_viperos.gschema.override schreiben
#   - os-release setzen
#   - das Logo als Distributions-Icon ablegen
#   - GRUB_DISTRIBUTOR aendern
#
# Reihenfolge: nach der Paketinstallation (die ViperOS-Dateien muessen schon
# existieren) und vor Hook 0090 (Cleanup).

set -e

echo "[ViperosOS] Entferne Debian-Branding..."

# ----------------------------------------------------------------------
# 1. Debian-Hintergruende aus der Auswahl nehmen
# ----------------------------------------------------------------------
removed=0
for f in /usr/share/gnome-background-properties/*.xml; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in
        viperos.xml) continue ;;          # unsere eigene behalten
    esac
    rm -f "$f"
    removed=$((removed + 1))
done
echo "  Hintergrund-Kataloge entfernt: $removed"

if [ ! -f /usr/share/gnome-background-properties/viperos.xml ]; then
    echo "  WARNUNG: viperos.xml fehlt - die Hintergrund-Auswahl bleibt leer."
    echo "  Ist viperos-desktop-theme installiert?"
fi

# Die Bilddaten selbst (22 MB) ebenfalls loeschen.
for d in /usr/share/desktop-base/*-theme; do
    [ -d "$d" ] || continue
    rm -rf "$d"
done
rm -rf /usr/share/images/desktop-base
echo "  Debian-Theme-Verzeichnisse entfernt"

# ----------------------------------------------------------------------
# 2. Debians gschema.override neutralisieren
#
# 10_desktop-base.gschema.override zwingt den Hintergrund auf Debians XML.
# Das eigene 90_viperos.gschema.override (aus viperos-settings) gewinnt
# bereits, weil 90 nach 10 gelesen wird; Debians Datei wird zusaetzlich
# geleert, damit sie gar nichts mehr setzt.
# ----------------------------------------------------------------------
if [ -f /usr/share/glib-2.0/schemas/10_desktop-base.gschema.override ]; then
    : > /usr/share/glib-2.0/schemas/10_desktop-base.gschema.override
    echo "  10_desktop-base.gschema.override geleert"
fi

# Nach dem Leeren neu kompilieren, sonst bleibt der alte Wert wirksam.
if command -v glib-compile-schemas >/dev/null 2>&1; then
    glib-compile-schemas /usr/share/glib-2.0/schemas/ >/dev/null 2>&1 \
        && echo "  GSettings-Schemata neu kompiliert" \
        || echo "  WARNUNG: glib-compile-schemas fehlgeschlagen"
fi

# ----------------------------------------------------------------------
# 3. Debian-Verknuepfungen aus dem Anwendungsmenue
# ----------------------------------------------------------------------
rm -f /usr/share/applications/debian-homepage.desktop \
      /usr/share/applications/debian-reference.desktop \
      /usr/share/applications/debian-security.desktop \
      /usr/share/desktop-base/debian-homepage.desktop \
      /usr/share/desktop-base/debian-reference.desktop \
      /usr/share/desktop-base/debian-security.desktop
echo "  Debian-Menueeintraege entfernt"

# ----------------------------------------------------------------------
# 4. Debian-Embleme und GRUB-Themes
# ----------------------------------------------------------------------
rm -rf /usr/share/icons/desktop-base
find /usr/share/icons/hicolor -name 'emblem-debian*' -delete 2>/dev/null || true
rm -f /boot/grub/themes/debian* 2>/dev/null || true

# Icon-Zwischenspeicher neu aufbauen, sonst bleibt das alte Logo sichtbar.
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

# ----------------------------------------------------------------------
# 5. Gegenpruefung: hat viperos-settings seine Arbeit getan?
#
# Die postinst des Pakets schreibt os-release. Laeuft sie nicht (etwa weil
# das Paket fehlt), traegt das Image weiterhin Debian-Daten - und das faellt
# sonst erst im gebooteten System auf.
# ----------------------------------------------------------------------
if grep -q '^ID=viperos' /usr/lib/os-release 2>/dev/null; then
    echo "  os-release traegt ViperOS-Daten"
else
    echo "  FEHLER: /usr/lib/os-release enthaelt noch Debian-Daten."
    echo "  Die postinst von viperos-settings ist nicht gelaufen."
    exit 1
fi

echo "[ViperosOS] Debian-Branding entfernt."
