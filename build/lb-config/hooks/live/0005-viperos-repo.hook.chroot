#!/bin/bash
# ViperosOS - ViperOS-Paketquelle gegenpruefen
#
# WICHTIG - das war zuvor falsch:
# Dieser Hook trug die Paketquelle selbst ein und holte den Signierschluessel
# per curl. Das konnte nicht funktionieren. live-build fuehrt ALLE
# *.hook.chroot erst in "chroot_hooks" aus, und das steht in seinem Ablauf
# NACH der Paketinstallation:
#
#   lb chroot_archives                    <- Quellen einbinden, apt update
#   lb chroot_includes_before_packages
#   for _PASS in install live; do
#       lb chroot_package-lists
#       lb chroot_install-packages        <- hier wird viperos-desktop geholt
#   done
#   lb chroot_includes_after_packages
#   lb chroot_hooks                       <- erst hier liefen wir
#
# Die Nummer 0005 steuert nur die Reihenfolge UNTER den Hooks, nicht relativ
# zur Installation. Der Build brach deshalb ab mit:
#   E: Unable to locate package viperos-desktop
#
# Richtig ist config/archives/ (build/lb-config/archives/):
#   viperos.list.chroot  - die Paketquelle
#   viperos.key.chroot   - der oeffentliche Signierschluessel
# live-build bindet beides in chroot_archives ein, legt den Schluessel nach
# /etc/apt/trusted.gpg.d/ und ruft danach "Apt chroot update" auf - alles vor
# der Installation.
#
# Auch includes.chroot_before_packages half nicht: die Dateien landen dort
# zwar rechtzeitig, aber chroot_install-packages fuehrt kein "apt-get update"
# aus (nur wenn fremde Architekturen dazukamen). apt kennt eine so abgelegte
# Quelle also nicht.
#
# Dieser Hook prueft jetzt nur noch nach, dass es geklappt hat - und dass die
# ViperOS-Pakete tatsaechlich aus dem eigenen Repo stammen.

set -e

echo "[ViperosOS] Pruefe ViperOS-Paketquelle..."

REPO_URL="https://jellystream-app.github.io/viperos-apt"

# ----------------------------------------------------------------------
# 1. Sind die eigenen Pakete installiert?
#
# Das ist die eigentliche Frage. Fehlen sie, hat live-build sie nicht
# installieren koennen - und das faellt sonst erst im gebooteten System auf,
# als Desktop ohne Theme, ohne Hub und ohne Paketquelle.
# ----------------------------------------------------------------------
missing=""
for pkg in viperos-settings viperos-desktop-theme \
           viperos-panel-extension viperos-hub viperos-desktop; do
    if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"; then
        echo "  installiert: $pkg $(dpkg-query -W -f='${Version}' "$pkg")"
    else
        missing="$missing $pkg"
    fi
done

if [ -n "$missing" ]; then
    echo "  FEHLER: diese ViperOS-Pakete fehlen:$missing"
    echo ""
    echo "  Moegliche Ursachen:"
    echo "    - build/lb-config/archives/ wurde nicht nach config/archives"
    echo "      kopiert (siehe die Kopierliste im Build-Workflow)"
    echo "    - das Repository ist nicht erreichbar oder leer"
    echo "    - die Signatur passt nicht zum Schluessel in archives/"
    exit 1
fi

# ----------------------------------------------------------------------
# 2. Stammen sie aus dem ViperOS-Repo?
#
# Ein Paket koennte theoretisch auch aus einer lokalen Ablage kommen. Dann
# waere das installierte System nicht an die Quelle angebunden, und genau
# das soll ViperOS 2.0 ja leisten.
# ----------------------------------------------------------------------
if apt-cache policy viperos-desktop 2>/dev/null | grep -qF "$REPO_URL"; then
    echo "  Herkunft bestaetigt: $REPO_URL"
else
    echo "  WARNUNG: viperos-desktop stammt nicht aus $REPO_URL"
    apt-cache policy viperos-desktop 2>&1 | sed 's/^/    /'
fi

# ----------------------------------------------------------------------
# 3. Bleibt die Quelle im installierten System eingetragen?
#
# Dafuer sorgt die Datei aus dem Paket viperos-settings. Der Eintrag aus
# config/archives gilt NUR waehrend des Builds: live-build loescht am Ende
# sowohl die Quelldatei als auch den Schluessel wieder (chroot_archives,
# "rm -f chroot/etc/apt/sources.list.d/..." und
# "rm chroot/etc/apt/trusted.gpg.d/..." im remove-Durchlauf).
#
# Das ist der Grund, warum viperos-settings die Quelle als PAKETDATEI
# mitbringt - ohne sie waere das installierte System von Updates
# abgeschnitten, also genau von dem, wofuer V2 gebaut wurde.
# ----------------------------------------------------------------------
if [ -f /etc/apt/sources.list.d/viperos.sources ]; then
    echo "  Dauerhafte Quelle vorhanden (aus viperos-settings):"
    grep -vE '^#|^$' /etc/apt/sources.list.d/viperos.sources | sed 's/^/    /'
else
    echo "  FEHLER: /etc/apt/sources.list.d/viperos.sources fehlt."
    echo "  Das installierte System waere von Updates abgeschnitten."
    exit 1
fi

if [ -f /usr/share/keyrings/viperos-archive-keyring.gpg ]; then
    echo "  Signierschluessel vorhanden ($(stat -c%s /usr/share/keyrings/viperos-archive-keyring.gpg) Bytes)"
else
    echo "  FEHLER: /usr/share/keyrings/viperos-archive-keyring.gpg fehlt."
    echo "  apt wuerde die Quelle als unsigniert ablehnen."
    exit 1
fi

echo "[ViperosOS] ViperOS-Paketquelle in Ordnung."
