#!/bin/bash
# ViperosOS - Anwendungen aus externen Quellen
#
# Dieser Hook installiert nur, was NICHT aus Debian oder dem ViperOS-Repo
# kommt: VS Code (Microsofts APT-Quelle), Jellystream (GitHub-Release mit
# gepinnter Pruefsumme) und Discord (Flathub). Alles Eigene liegt seit V2 in
# packages/ und kommt ueber das Metapaket viperos-desktop.
set -e

# /usr/local/lib/viperos wird hier nicht mehr angelegt: update-system liegt
# jetzt im Paket viperos-hub unter /usr/lib/viperos/.
mkdir -p /etc/apt/keyrings /tmp/viperos-apps

curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /etc/apt/keyrings/microsoft.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list
apt-get update
apt-get install -y code

JELLYSTREAM_VERSION="2.14.0"
JELLYSTREAM_DEB="Jellystream-${JELLYSTREAM_VERSION}-amd64.deb"
curl -fL --retry 3 --proto '=https' -o "/tmp/viperos-apps/${JELLYSTREAM_DEB}" "https://github.com/jellystream-app/jellystream/releases/download/v${JELLYSTREAM_VERSION}/${JELLYSTREAM_DEB}"
printf '%s' 'LVQSTLE5sdx7aQvq3x7r2joNG95P459dvRDp9XwWtgtZzyLK7hpm7QUxktdLj2kOacM6Z3ki3sJpjuHZFsx9zw==' | base64 -d > /tmp/viperos-apps/jellystream.expected
openssl dgst -sha512 -binary "/tmp/viperos-apps/${JELLYSTREAM_DEB}" > /tmp/viperos-apps/jellystream.actual
cmp /tmp/viperos-apps/jellystream.expected /tmp/viperos-apps/jellystream.actual
apt-get install -y "/tmp/viperos-apps/${JELLYSTREAM_DEB}"

flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install --system -y --noninteractive flathub com.discordapp.Discord
rm -rf /tmp/viperos-apps

# ----------------------------------------------------------------------
# Jellystream als offizielle ViperOS-Anwendung kennzeichnen
#
# Jellystream stammt von denselben Entwicklern wie ViperOS. Das .deb bringt
# einen generischen Eintrag mit; hier wird er durch eine eigene Fassung
# ersetzt, die die Herkunft benennt - im Anwendungsmenue und in der
# Softwareverwaltung.
# ----------------------------------------------------------------------
JS_ICON=""
for candidate in /usr/share/icons/hicolor/512x512/apps/jellystream.png \
                 /usr/share/icons/hicolor/256x256/apps/jellystream.png \
                 /opt/Jellystream/resources/app/icon.png \
                 /usr/share/pixmaps/jellystream.png; do
    [ -f "$candidate" ] && { JS_ICON="$candidate"; break; }
done

# Startbefehl aus dem vorhandenen Eintrag uebernehmen, damit der korrekte
# Pfad und etwaige Parameter erhalten bleiben.
JS_EXEC="jellystream %U"
for d in /usr/share/applications/jellystream.desktop \
         /usr/share/applications/Jellystream.desktop; do
    if [ -f "$d" ]; then
        found=$(grep -m1 '^Exec=' "$d" | cut -d= -f2-)
        [ -n "$found" ] && JS_EXEC="$found"
        break
    fi
done

cat > /usr/share/applications/jellystream.desktop << EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Jellystream
GenericName=Media Streaming
GenericName[de]=Medien-Streaming
Comment=Official ViperOS app - streaming from the ViperOS developers
Comment[de]=Offizielle ViperOS-App - Streaming von den ViperOS-Entwicklern
Exec=${JS_EXEC}
Icon=${JS_ICON:-jellystream}
Terminal=false
StartupNotify=true
StartupWMClass=Jellystream
Categories=AudioVideo;Video;Player;Network;
Keywords=stream;streaming;media;video;jellystream;viperos;
X-ViperOS-Official=true
X-ViperOS-Vendor=ViperOS Project
EOF

# AppStream-Metadaten: hierueber zeigen Softwareverwaltungen Entwickler und
# Herkunft an. Ohne diese Datei stuende dort nur der Paketname.
mkdir -p /usr/share/metainfo
cat > /usr/share/metainfo/app.viperos.Jellystream.metainfo.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.viperos.Jellystream</id>
  <launchable type="desktop-id">jellystream.desktop</launchable>
  <name>Jellystream</name>
  <summary>Official ViperOS streaming app</summary>
  <summary xml:lang="de">Offizielle ViperOS-Streaming-App</summary>
  <developer id="app.viperos">
    <name>ViperOS Project</name>
  </developer>
  <project_license>LicenseRef-proprietary</project_license>
  <metadata_license>CC0-1.0</metadata_license>
  <description>
    <p>
      Jellystream is developed by the same team as ViperOS and ships
      preinstalled as an official system application.
    </p>
    <p xml:lang="de">
      Jellystream stammt vom selben Team wie ViperOS und ist als offizielle
      Systemanwendung vorinstalliert.
    </p>
  </description>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Player</category>
  </categories>
  <url type="homepage">https://viperos.os/</url>
  <content_rating type="oars-1.1"/>
</component>
EOF

echo "[ViperosOS] Jellystream als offizielle App gekennzeichnet."

# ----------------------------------------------------------------------
# ViperOS Hub: seit V2 ein eigenes Paket
#
# Hier stand bis V1 der komplette Hub - ein ~700-zeiliges Python-Programm
# als Here-Doc, dazu update-system und der Menueeintrag. Das hatte einen
# schweren Nachteil: der Hub entstand nur beim ISO-Bau. Wer ViperOS
# installiert hatte, behielt fuer immer die Fassung seines Installations-
# mediums; eine Verbesserung erreichte ihn erst bei einer Neuinstallation.
#
# Jetzt liegt der Hub in packages/viperos-hub/ und wird als .deb ueber das
# ViperOS-Repo ausgeliefert. Damit gilt:
#
#   - "apt upgrade" bringt neue Fassungen auf bereits installierte Systeme
#   - der Quelltext ist eine echte Datei und damit pruefbar, ohne ein
#     1,8-GB-ISO zu bauen
#   - jede Aenderung hat eine Version und einen Changelog-Eintrag
#
# Ins Image kommt der Hub ueber das Metapaket viperos-desktop in der
# Paketliste, nicht mehr ueber diesen Hook. NICHT wieder hier einfuegen -
# zwei Fassungen derselben Datei wuerden sonst auseinanderlaufen, und die
# aus dem Hook gewinnt, weil sie spaeter geschrieben wird.
# ----------------------------------------------------------------------
