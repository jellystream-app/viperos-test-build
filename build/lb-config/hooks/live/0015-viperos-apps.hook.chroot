#!/bin/bash
set -e

mkdir -p /usr/local/lib/viperos /etc/apt/keyrings /tmp/viperos-apps

curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /etc/apt/keyrings/microsoft.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list
apt-get update
apt-get install -y code

JELLYSTREAM_VERSION="2.14.0"
JELLYSTREAM_DEB="Jellystream-${JELLYSTREAM_VERSION}-amd64.deb"
curl -fL --retry 3 --proto '=https' -o "/tmp/viperos-apps/${JELLYSTREAM_DEB}" "https://github.com/jellystream-app/jellystream/releases/download/v${JELLYSTREAM_VERSION}/${JELLYSTREAM_DEB}"
printf '%s' 'LVQSTLE5sdx7aQvq3x7r2joNG95P459dvRDp9XwWtgtZzyLK7hpm7QUxktdLj2kOacM6Z3ki3sJpjuHZFsx9zw==' | base64 -d > /tmp/viperos-apps/jellystream.expected
openssl dgst -sha512 -binary "/tmp/viperos-apps/${JELLYSTREAM_DEB}" > /tmp/viperos-apps/jellystream.actual
cmp /tmp/viperos-apps/jellystream.expected /tmp/viperos-apps/jellystream.actual
apt-get install -y "/tmp/viperos-apps/${JELLYSTREAM_DEB}"

flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install --system -y --noninteractive flathub com.discordapp.Discord
rm -rf /tmp/viperos-apps

cat > /usr/local/lib/viperos/update-system << 'EOF'
#!/bin/sh
set -eu
apt-get update
apt-get upgrade -y
EOF
chmod 0755 /usr/local/lib/viperos/update-system

cat > /usr/local/bin/viperos-hub << 'PYEOF'
#!/usr/bin/env python3
import os
import subprocess
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

LIVE_SYSTEM = os.path.exists("/run/live/medium")

class ViperHub(Gtk.Window):
    def __init__(self):
        super().__init__(title="ViperOS Hub")
        self.set_default_size(760, 500)
        self.set_border_width(32)
        self.connect("destroy", Gtk.main_quit)
        css = Gtk.CssProvider()
        css.load_from_data(b"""window { background: #101827; color: #e7eef9; }
        .title { font-size: 30px; font-weight: 700; color: #ffffff; }
        .subtle { font-size: 14px; color: #a9b8ce; }
        button { background: #1d2b40; color: #eef5ff; border: 1px solid #34506f; border-radius: 10px; padding: 16px; }
        button:hover { background: #294362; }
        .accent { background: #2b78c5; border-color: #55a5f7; }
        .card { background: #162235; border-radius: 14px; padding: 22px; }""")
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        self.add(root)
        title = Gtk.Label(label="ViperOS Hub", xalign=0)
        title.get_style_context().add_class("title")
        subtitle = Gtk.Label(label="Dein System. Klar, schnell und unter deiner Kontrolle.", xalign=0)
        subtitle.get_style_context().add_class("subtle")
        root.pack_start(title, False, False, 0)
        root.pack_start(subtitle, False, False, 0)
        status = Gtk.Label(label="Systemstatus: bereit", xalign=0)
        status.get_style_context().add_class("card")
        root.pack_start(status, False, False, 0)
        grid = Gtk.Grid(column_spacing=14, row_spacing=14)
        root.pack_start(grid, True, True, 0)
        self.add_button(grid, "System aktualisieren", "Installiert geprüfte Debian-Sicherheitsupdates.", 0, 0, self.update_system, True)
        self.add_button(grid, "Netzwerk", "WLAN, VPN und Verbindungen verwalten.", 1, 0, self.network)
        self.add_button(grid, "Software", "Flatpak-Anwendungen verwalten.", 0, 1, self.software)
        self.add_button(grid, "Systeminformationen", "Version und Hardwaredetails anzeigen.", 1, 1, self.info)
        if LIVE_SYSTEM:
            self.add_button(grid, "ViperOS installieren", "ViperOS dauerhaft auf diesem Gerät installieren.", 0, 2, self.install, True)

    def add_button(self, grid, name, description, column, row, callback, accent=False):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        label = Gtk.Label(xalign=0)
        label.set_markup("<b>%s</b>" % name)
        detail = Gtk.Label(label=description, xalign=0)
        detail.set_line_wrap(True)
        detail.get_style_context().add_class("subtle")
        box.pack_start(label, False, False, 0)
        box.pack_start(detail, False, False, 0)
        button = Gtk.Button()
        button.add(box)
        if accent:
            button.get_style_context().add_class("accent")
        button.connect("clicked", callback)
        grid.attach(button, column, row, 1, 1)

    def run(self, command):
        subprocess.Popen(command)
    def update_system(self, _): self.run(["pkexec", "/usr/local/lib/viperos/update-system"])
    def network(self, _): self.run(["nm-connection-editor"])
    def software(self, _): self.run(["xfce4-terminal", "--command", "flatpak --user remote-ls flathub; exec bash"])
    def install(self, _): self.run(["pkexec", "calamares"])
    def info(self, _): self.run(["xfce4-terminal", "--command", "bash -lc 'fastfetch || uname -a; exec bash'"])

hub = ViperHub()
hub.show_all()
Gtk.main()
PYEOF
chmod 0755 /usr/local/bin/viperos-hub

cat > /usr/share/applications/viperos-hub.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=ViperOS Hub
Comment=System, software and setup
Exec=viperos-hub
Icon=viperos
Terminal=false
Categories=Settings;System;
EOF
