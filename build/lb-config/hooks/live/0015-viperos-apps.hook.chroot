#!/bin/bash
set -e

mkdir -p /usr/local/lib/viperos /etc/apt/keyrings /tmp/viperos-apps

curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /etc/apt/keyrings/microsoft.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list
apt-get update
apt-get install -y code

JELLYSTREAM_VERSION="2.14.0"
JELLYSTREAM_DEB="Jellystream-${JELLYSTREAM_VERSION}-amd64.deb"
curl -fL --retry 3 --proto '=https' -o "/tmp/viperos-apps/${JELLYSTREAM_DEB}" "https://github.com/jellystream-app/jellystream/releases/download/v${JELLYSTREAM_VERSION}/${JELLYSTREAM_DEB}"
printf '%s' 'LVQSTLE5sdx7aQvq3x7r2joNG95P459dvRDp9XwWtgtZzyLK7hpm7QUxktdLj2kOacM6Z3ki3sJpjuHZFsx9zw==' | base64 -d > /tmp/viperos-apps/jellystream.expected
openssl dgst -sha512 -binary "/tmp/viperos-apps/${JELLYSTREAM_DEB}" > /tmp/viperos-apps/jellystream.actual
cmp /tmp/viperos-apps/jellystream.expected /tmp/viperos-apps/jellystream.actual
apt-get install -y "/tmp/viperos-apps/${JELLYSTREAM_DEB}"

flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install --system -y --noninteractive flathub com.discordapp.Discord
rm -rf /tmp/viperos-apps

cat > /usr/local/lib/viperos/update-system << 'EOF'
#!/bin/sh
set -eu
apt-get update
apt-get upgrade -y
EOF
chmod 0755 /usr/local/lib/viperos/update-system

cat > /usr/local/bin/viperos-hub << 'PYEOF'
#!/usr/bin/env python3
"""ViperOS Hub - Systemzentrale

Zeigt echte Systemdaten an, statt nur Programme zu starten: Sidebar-Navigation,
Live-Kacheln fuer RAM/Datentraeger/Netzwerk, Geraeteuebersicht. Die Optik folgt
dem Dark-Glass-Thema des Desktops (#0f1626 -> #162235, Akzent #55a5f7).
"""
import os
import shutil
import socket
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

def detect_live():
    """Laeuft ViperOS vom Live-Medium?

    Nicht an einem einzelnen Pfad festmachen: /run/live/medium wird von
    live-boot nur an zwei Stellen gesetzt und kann je nach Bootart fehlen
    (findiso, fromiso, toram). Faellt die Erkennung falsch aus, verschwindet
    der Installationsknopf - also mehrere Marker pruefen.
    """
    for path in ("/run/live/medium", "/run/live/overlay",
                 "/run/live/rootfs", "/lib/live/mount/medium"):
        if os.path.exists(path):
            return True
    try:
        with open("/proc/cmdline", "r", encoding="utf-8", errors="replace") as fh:
            cmdline = fh.read()
        if "boot=live" in cmdline or "findiso=" in cmdline or "fromiso=" in cmdline:
            return True
    except OSError:
        pass
    # Letzter Hinweis: das Wurzeldateisystem eines Live-Systems ist ein
    # overlay bzw. aufs, keine echte Partition.
    try:
        with open("/proc/mounts", "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.split()
                if len(parts) >= 3 and parts[1] == "/" and parts[2] in ("overlay", "aufs", "overlayfs"):
                    return True
    except OSError:
        pass
    return False


LIVE_SYSTEM = detect_live()
ACCENT = "#55a5f7"

CSS = b"""
window, .page { background-color: #0f1626; }
.sidebar { background-color: #0b111d; border-right: 1px solid #1e2c44; }
.brand-name { font-size: 19px; font-weight: 800; color: #ffffff; }
.brand-sub  { font-size: 11px; color: #7f92ad; letter-spacing: 1px; }
.navbtn {
    background-image: none; background-color: transparent; border: none;
    border-radius: 8px; padding: 10px 14px; color: #a9b8ce;
    font-size: 14px; font-weight: 600;
}
.navbtn:hover { background-color: #16233a; color: #e7eef9; }
.navbtn.active { background-color: #1b2e4d; color: #ffffff; }
.h1 { font-size: 26px; font-weight: 800; color: #ffffff; }
.h2 { font-size: 15px; font-weight: 700; color: #e7eef9; }
.sub { font-size: 13px; color: #8ea3c0; }
.tiny { font-size: 11px; color: #6f83a0; }
.card {
    background-color: #16233a; border: 1px solid #22344f;
    border-radius: 14px; padding: 18px;
}
.card-accent { border-color: #2f5a8d; }
.metric { font-size: 22px; font-weight: 800; color: #ffffff; }
.action {
    background-image: none; background-color: #1d2b40; color: #eef5ff;
    border: 1px solid #34506f; border-radius: 10px; padding: 12px 16px;
    font-weight: 600;
}
.action:hover { background-color: #294362; border-color: #4a7ab5; }
.action.primary { background-color: #2b78c5; border-color: #55a5f7; color: #ffffff; }
.action.primary:hover { background-color: #3a8ade; }
.pill {
    background-color: #12324e; color: #7fc4ff; border-radius: 999px;
    padding: 3px 12px; font-size: 11px; font-weight: 700;
}
.pill.warn { background-color: #4a3410; color: #ffc46b; }
progressbar trough { background-color: #0d1524; border-radius: 999px; min-height: 7px; }
progressbar progress { background-color: #55a5f7; border-radius: 999px; min-height: 7px; }
progressbar.hot progress { background-color: #ff8a5b; }
separator { background-color: #1e2c44; }
"""


def run_cmd(args, timeout=2):
    """Externes Kommando, Ausgabe als Text. Leer bei Fehler oder Timeout."""
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return out.stdout.strip()
    except Exception:
        return ""


def read_file(path, default=""):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return default


def os_release():
    data = {}
    for line in read_file("/etc/os-release").splitlines():
        if "=" in line:
            key, _, value = line.partition("=")
            data[key] = value.strip().strip('"')
    return data


def meminfo():
    total = avail = 0
    for line in read_file("/proc/meminfo").splitlines():
        parts = line.split()
        if len(parts) >= 2:
            if parts[0] == "MemTotal:":
                total = int(parts[1]) * 1024
            elif parts[0] == "MemAvailable:":
                avail = int(parts[1]) * 1024
    return total, total - avail


def uptime_text():
    raw = read_file("/proc/uptime").split()
    if not raw:
        return "unbekannt"
    seconds = int(float(raw[0]))
    days, rest = divmod(seconds, 86400)
    hours, rest = divmod(rest, 3600)
    minutes = rest // 60
    if days:
        return "%d T %d Std %d Min" % (days, hours, minutes)
    if hours:
        return "%d Std %d Min" % (hours, minutes)
    return "%d Min" % minutes


def human(size):
    value = float(size)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if value < 1024 or unit == "TB":
            return "%.0f %s" % (value, unit) if unit in ("B", "KB") else "%.1f %s" % (value, unit)
        value /= 1024
    return "%.1f TB" % value


def cpu_model():
    for line in read_file("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            return line.split(":", 1)[1].strip()
    return "unbekannt"


def cpu_cores():
    return os.cpu_count() or 1


def network_state():
    """(verbunden, Beschreibung) - erst NetworkManager, sonst /sys/class/net."""
    state = run_cmd(["nmcli", "-t", "-f", "STATE", "general"])
    name = run_cmd(["nmcli", "-t", "-f", "NAME", "connection", "show", "--active"])
    primary = name.splitlines()[0] if name else ""
    if state:
        if state.startswith("connected"):
            return True, primary or "verbunden"
        return False, "getrennt"
    # Fallback ohne nmcli
    try:
        for iface in sorted(os.listdir("/sys/class/net")):
            if iface == "lo":
                continue
            if read_file("/sys/class/net/%s/operstate" % iface) == "up":
                return True, iface
    except OSError:
        pass
    return False, "getrennt"


def gpu_model():
    out = run_cmd(["lspci"], timeout=3)
    for line in out.splitlines():
        low = line.lower()
        if "vga compatible controller" in low or " 3d controller" in low:
            return line.split(":", 2)[-1].strip()
    return "unbekannt"


class Hub(Gtk.Window):
    def __init__(self):
        super().__init__(title="ViperOS Hub")
        self.set_default_size(940, 620)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", Gtk.main_quit)
        for path in ("/usr/share/icons/hicolor/scalable/apps/viperos.svg",
                     "/usr/share/pixmaps/viperos.png"):
            if os.path.exists(path):
                try:
                    self.set_icon_from_file(path)
                    break
                except GLib.Error:
                    pass

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(outer)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(160)

        outer.pack_start(self.build_sidebar(), False, False, 0)
        outer.pack_start(self.stack, True, True, 0)

        self.stack.add_named(self.page_overview(), "overview")
        self.stack.add_named(self.page_system(), "system")
        self.stack.add_named(self.page_software(), "software")
        self.stack.add_named(self.page_about(), "about")
        self.select_page("overview")

        self.refresh()
        GLib.timeout_add_seconds(5, self.refresh)

    # ---------------------------------------------------------------- Sidebar
    def build_sidebar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        bar.get_style_context().add_class("sidebar")
        bar.set_size_request(212, -1)
        bar.set_border_width(16)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        logo = None
        for path in ("/usr/share/icons/hicolor/scalable/apps/viperos.svg",
                     "/usr/share/pixmaps/viperos.png"):
            if os.path.exists(path):
                try:
                    logo = Gtk.Image.new_from_pixbuf(
                        __import__("gi.repository.GdkPixbuf", fromlist=["GdkPixbuf"])
                        .GdkPixbuf.Pixbuf.new_from_file_at_size(path, 34, 34))
                    break
                except Exception:
                    logo = None
        if logo is not None:
            head.pack_start(logo, False, False, 0)
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        name = Gtk.Label(label="ViperOS", xalign=0)
        name.get_style_context().add_class("brand-name")
        sub = Gtk.Label(label="HUB", xalign=0)
        sub.get_style_context().add_class("brand-sub")
        titles.pack_start(name, False, False, 0)
        titles.pack_start(sub, False, False, 0)
        head.pack_start(titles, False, False, 0)
        bar.pack_start(head, False, False, 0)
        bar.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 12)

        self.nav_buttons = {}
        for key, label in (("overview", "Übersicht"),
                           ("system", "System"),
                           ("software", "Software"),
                           ("about", "Über")):
            button = Gtk.Button(label=label)
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.get_style_context().add_class("navbtn")
            button.get_child().set_xalign(0.0)
            button.connect("clicked", lambda _b, k=key: self.select_page(k))
            bar.pack_start(button, False, False, 0)
            self.nav_buttons[key] = button

        bar.pack_end(self.build_mode_badge(), False, False, 0)
        return bar

    def build_mode_badge(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        text = "Live-Sitzung" if LIVE_SYSTEM else "Installiert"
        badge = Gtk.Label(label=text)
        badge.get_style_context().add_class("pill")
        if LIVE_SYSTEM:
            badge.get_style_context().add_class("warn")
        badge.set_halign(Gtk.Align.START)
        box.pack_start(badge, False, False, 0)
        if LIVE_SYSTEM:
            note = Gtk.Label(label="Änderungen gehen beim\nNeustart verloren.", xalign=0)
            note.get_style_context().add_class("tiny")
            box.pack_start(note, False, False, 0)
        return box

    def select_page(self, key):
        self.stack.set_visible_child_name(key)
        for name, button in self.nav_buttons.items():
            ctx = button.get_style_context()
            if name == key:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")

    # -------------------------------------------------------------- Bausteine
    def page_shell(self, title, subtitle):
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        page.get_style_context().add_class("page")
        page.set_border_width(28)
        head = Gtk.Label(label=title, xalign=0)
        head.get_style_context().add_class("h1")
        page.pack_start(head, False, False, 0)
        if subtitle:
            sub = Gtk.Label(label=subtitle, xalign=0)
            sub.get_style_context().add_class("sub")
            page.pack_start(sub, False, False, 0)
        scroller.add(page)
        return scroller, page

    def metric_card(self, title):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("card")
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("sub")
        value = Gtk.Label(label="–", xalign=0)
        value.get_style_context().add_class("metric")
        bar = Gtk.ProgressBar()
        bar.set_fraction(0.0)
        detail = Gtk.Label(label="", xalign=0)
        detail.get_style_context().add_class("tiny")
        card.pack_start(label, False, False, 0)
        card.pack_start(value, False, False, 0)
        card.pack_start(bar, False, False, 2)
        card.pack_start(detail, False, False, 0)
        return card, value, bar, detail

    def info_row(self, grid, row, key, value):
        left = Gtk.Label(label=key, xalign=0)
        left.get_style_context().add_class("sub")
        right = Gtk.Label(label=value, xalign=0)
        right.get_style_context().add_class("h2")
        right.set_ellipsize(Pango.EllipsizeMode.END)
        right.set_max_width_chars(46)
        right.set_selectable(True)
        grid.attach(left, 0, row, 1, 1)
        grid.attach(right, 1, row, 1, 1)
        return right

    def action_button(self, label, description, callback, primary=False):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        title = Gtk.Label(xalign=0)
        title.set_markup("<b>%s</b>" % GLib.markup_escape_text(label))
        detail = Gtk.Label(label=description, xalign=0)
        detail.set_line_wrap(True)
        detail.get_style_context().add_class("tiny")
        box.pack_start(title, False, False, 0)
        box.pack_start(detail, False, False, 0)
        button = Gtk.Button()
        button.add(box)
        button.get_style_context().add_class("action")
        if primary:
            button.get_style_context().add_class("primary")
        button.connect("clicked", callback)
        return button

    # ----------------------------------------------------------------- Seiten
    def page_overview(self):
        host = socket.gethostname()
        scroller, page = self.page_shell(
            "Willkommen bei ViperOS",
            "%s · %s" % (os_release().get("PRETTY_NAME", "ViperOS"), host))

        cards = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14,
                        homogeneous=True)
        ram_card, self.ram_value, self.ram_bar, self.ram_detail = self.metric_card("Arbeitsspeicher")
        disk_card, self.disk_value, self.disk_bar, self.disk_detail = self.metric_card("Datenträger /")
        cards.pack_start(ram_card, True, True, 0)
        cards.pack_start(disk_card, True, True, 0)
        page.pack_start(cards, False, False, 0)

        status = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        status.get_style_context().add_class("card")
        status.get_style_context().add_class("card-accent")
        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        head = Gtk.Label(label="Netzwerk", xalign=0)
        head.get_style_context().add_class("h2")
        self.net_pill = Gtk.Label(label="prüfe …")
        self.net_pill.get_style_context().add_class("pill")
        line.pack_start(head, False, False, 0)
        line.pack_end(self.net_pill, False, False, 0)
        status.pack_start(line, False, False, 0)
        self.net_detail = Gtk.Label(label="", xalign=0)
        self.net_detail.get_style_context().add_class("sub")
        status.pack_start(self.net_detail, False, False, 0)
        self.uptime_label = Gtk.Label(label="", xalign=0)
        self.uptime_label.get_style_context().add_class("tiny")
        status.pack_start(self.uptime_label, False, False, 0)
        page.pack_start(status, False, False, 0)

        actions = Gtk.FlowBox()
        actions.set_selection_mode(Gtk.SelectionMode.NONE)
        actions.set_max_children_per_line(2)
        actions.set_column_spacing(12)
        actions.set_row_spacing(12)
        actions.set_homogeneous(True)
        # Installationsknopf immer anzeigen. Haengt er an der Live-Erkennung
        # und die schlaegt fehl, ist der Installer unerreichbar - genau das
        # Problem, das hier behoben wird. Ist calamares nicht vorhanden,
        # erklaert der Knopf das beim Klick statt einfach zu fehlen.
        actions.add(self.action_button(
            "ViperOS installieren",
            "Dauerhaft auf diesem Gerät einrichten.",
            self.on_install, primary=True))
        actions.add(self.action_button(
            "System aktualisieren", "Sicherheitsupdates einspielen.",
            self.on_update))
        actions.add(self.action_button(
            "Netzwerk verwalten", "WLAN, VPN und Verbindungen.", self.on_network))
        actions.add(self.action_button(
            "Dateien öffnen", "Persönlicher Ordner in Thunar.", self.on_files))
        page.pack_start(actions, False, False, 0)
        return scroller

    def page_system(self):
        scroller, page = self.page_shell("System", "Hardware und Betriebssystem")
        grid = Gtk.Grid(column_spacing=26, row_spacing=10)
        grid.get_style_context().add_class("card")
        data = os_release()
        uname = os.uname()
        rows = (
            ("Betriebssystem", data.get("PRETTY_NAME", "ViperOS")),
            ("Version", data.get("VERSION", "1.0")),
            ("Basis", "Debian 13 (Trixie)"),
            ("Kernel", "%s %s" % (uname.sysname, uname.release)),
            ("Architektur", uname.machine),
            ("Rechnername", socket.gethostname()),
            ("Prozessor", cpu_model()),
            ("Kerne", str(cpu_cores())),
            ("Grafik", gpu_model()),
            ("Desktop", os.environ.get("XDG_CURRENT_DESKTOP", "XFCE")),
            ("Sitzung", "Live-Medium" if LIVE_SYSTEM else "Installiert"),
        )
        for index, (key, value) in enumerate(rows):
            self.info_row(grid, index, key, value)
        page.pack_start(grid, False, False, 0)

        tools = Gtk.FlowBox()
        tools.set_selection_mode(Gtk.SelectionMode.NONE)
        tools.set_max_children_per_line(2)
        tools.set_column_spacing(12)
        tools.set_row_spacing(12)
        tools.set_homogeneous(True)
        tools.add(self.action_button("Systemmonitor", "Prozesse und Auslastung.", self.on_taskmanager))
        tools.add(self.action_button("Laufwerke", "Partitionen mit GParted.", self.on_disks))
        tools.add(self.action_button("Terminal", "Kommandozeile öffnen.", self.on_terminal))
        tools.add(self.action_button("Einstellungen", "XFCE-Systemeinstellungen.", self.on_settings))
        page.pack_start(tools, False, False, 0)
        return scroller

    def page_software(self):
        scroller, page = self.page_shell(
            "Software", "Anwendungen installieren und aktualisieren")
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.get_style_context().add_class("card")
        head = Gtk.Label(label="Vorinstalliert", xalign=0)
        head.get_style_context().add_class("h2")
        card.pack_start(head, False, False, 0)
        preinstalled = ("Firefox ESR", "VS Code", "Discord", "Jellystream",
                        "LibreOffice", "GIMP", "Inkscape", "Audacity",
                        "OBS Studio", "VLC", "KeePassXC", "Thunar")
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(4)
        flow.set_column_spacing(8)
        flow.set_row_spacing(8)
        for app in preinstalled:
            chip = Gtk.Label(label=app)
            chip.get_style_context().add_class("pill")
            flow.add(chip)
        card.pack_start(flow, False, False, 4)
        page.pack_start(card, False, False, 0)

        actions = Gtk.FlowBox()
        actions.set_selection_mode(Gtk.SelectionMode.NONE)
        actions.set_max_children_per_line(2)
        actions.set_column_spacing(12)
        actions.set_row_spacing(12)
        actions.set_homogeneous(True)
        actions.add(self.action_button(
            "Updates einspielen", "Paketquellen aktualisieren und upgraden.",
            self.on_update, primary=True))
        actions.add(self.action_button(
            "Flatpak-Anwendungen", "Installierte Flatpaks anzeigen.", self.on_flatpak))
        actions.add(self.action_button(
            "Paketverwaltung", "APT im Terminal.", self.on_apt))
        page.pack_start(actions, False, False, 0)
        return scroller

    def page_about(self):
        scroller, page = self.page_shell("Über ViperOS", "")
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.get_style_context().add_class("card")
        text = Gtk.Label(xalign=0)
        text.set_line_wrap(True)
        text.set_markup(
            "<b>ViperOS 1.0</b>\n\n"
            "Ein schlankes Live-System auf Basis von Debian 13 (Trixie) mit "
            "XFCE-Desktop. Gedacht zum Ausprobieren, Arbeiten und Installieren – "
            "ohne Ballast und ohne Telemetrie.\n\n"
            "Der Desktop läuft mit Arc-Dark und Papirus-Icons, der Ton über "
            "PipeWire, das Netzwerk über NetworkManager. Installiert wird mit "
            "Calamares.")
        card.pack_start(text, False, False, 0)
        page.pack_start(card, False, False, 0)

        if LIVE_SYSTEM:
            hint = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            hint.get_style_context().add_class("card")
            head = Gtk.Label(label="Live-Zugang", xalign=0)
            head.get_style_context().add_class("h2")
            body = Gtk.Label(
                label="Benutzer: viperos    Passwort: viperos\n"
                      "Gilt nur in dieser Sitzung; die Installation legt ein "
                      "eigenes Konto an.", xalign=0)
            body.get_style_context().add_class("sub")
            hint.pack_start(head, False, False, 0)
            hint.pack_start(body, False, False, 0)
            page.pack_start(hint, False, False, 0)
        return scroller

    # ------------------------------------------------------------ Aktualisierung
    def refresh(self):
        total, used = meminfo()
        if total:
            share = used / total
            self.ram_value.set_text("%s / %s" % (human(used), human(total)))
            self.ram_bar.set_fraction(min(share, 1.0))
            self.ram_detail.set_text("%d %% belegt" % round(share * 100))
            ctx = self.ram_bar.get_style_context()
            ctx.add_class("hot") if share > 0.85 else ctx.remove_class("hot")

        try:
            usage = shutil.disk_usage("/")
            share = usage.used / usage.total if usage.total else 0
            self.disk_value.set_text("%s / %s" % (human(usage.used), human(usage.total)))
            self.disk_bar.set_fraction(min(share, 1.0))
            self.disk_detail.set_text("%s frei" % human(usage.free))
            ctx = self.disk_bar.get_style_context()
            ctx.add_class("hot") if share > 0.9 else ctx.remove_class("hot")
        except OSError:
            pass

        online, description = network_state()
        self.net_pill.set_text("verbunden" if online else "getrennt")
        ctx = self.net_pill.get_style_context()
        ctx.remove_class("warn") if online else ctx.add_class("warn")
        self.net_detail.set_text(
            "Aktive Verbindung: %s" % description if online
            else "Keine Verbindung. Über „Netzwerk verwalten“ einrichten.")
        self.uptime_label.set_text("Laufzeit: %s" % uptime_text())
        return True

    # ------------------------------------------------------------------ Aktionen
    def launch(self, args):
        try:
            subprocess.Popen(args)
        except OSError as error:
            dialog = Gtk.MessageDialog(
                transient_for=self, modal=True,
                message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.CLOSE,
                text="Konnte nicht starten")
            dialog.format_secondary_text("%s\n%s" % (" ".join(args), error))
            dialog.run()
            dialog.destroy()

    def term(self, command):
        self.launch(["xfce4-terminal", "--command",
                     "bash -lc '%s; echo; read -p \"Enter zum Schliessen\"'" % command])

    def problem(self, title, detail):
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.CLOSE,
            text=title)
        dialog.format_secondary_text(detail)
        dialog.run()
        dialog.destroy()

    def on_install(self, _b):
        """Installation starten - mit klarer Meldung, wenn etwas fehlt.

        pkexec zeigt seinen Passwortdialog nur, wenn in der Sitzung ein
        polkit-Authentication-Agent laeuft. Fehlt er, passierte bisher
        einfach nichts. Hier wird das geprueft und benannt.
        """
        if shutil.which("calamares") is None:
            self.problem("Installer nicht gefunden",
                         "Das Paket calamares ist in diesem Image nicht "
                         "vorhanden. Eine Installation ist damit nicht "
                         "moeglich.")
            return

        agent_running = False
        for name in ("lxpolkit", "polkit-gnome-authentication-agent-1",
                     "polkit-mate-authentication-agent-1",
                     "polkit-kde-authentication-agent-1", "xfce-polkit"):
            if subprocess.run(["pgrep", "-x", name],
                              capture_output=True).returncode == 0:
                agent_running = True
                break

        if not agent_running and shutil.which("lxpolkit"):
            # Agent nachstarten und ihm einen Moment geben, sich am
            # Systembus zu registrieren.
            try:
                subprocess.Popen(["lxpolkit"])
                GLib.timeout_add_seconds(
                    2, lambda: (self.launch(["pkexec", "calamares"]), False)[1])
                return
            except OSError:
                pass

        if not agent_running:
            self.problem(
                "Berechtigungsdialog nicht verfuegbar",
                "Es laeuft kein PolicyKit-Agent, deshalb kann nicht nach dem "
                "Administratorpasswort gefragt werden.\n\n"
                "Alternative: ein Terminal oeffnen und dort eingeben:\n"
                "    sudo calamares")
            return

        self.launch(["pkexec", "calamares"])
    def on_update(self, _b):    self.launch(["pkexec", "/usr/local/lib/viperos/update-system"])
    def on_network(self, _b):   self.launch(["nm-connection-editor"])
    def on_files(self, _b):     self.launch(["thunar", os.path.expanduser("~")])
    def on_taskmanager(self, _b): self.launch(["xfce4-taskmanager"])
    def on_disks(self, _b):     self.launch(["pkexec", "gparted"])
    def on_terminal(self, _b):  self.launch(["xfce4-terminal"])
    def on_settings(self, _b):  self.launch(["xfce4-settings-manager"])
    def on_flatpak(self, _b):   self.term("flatpak list")
    def on_apt(self, _b):       self.term("apt list --upgradable")


def main():
    window = Hub()
    window.show_all()
    Gtk.main()


main()
PYEOF
