#!/bin/bash
# ViperosOS - Theme-Pruefung
#
# Hier stand bis V1 die Zusammensetzung des Shell-Themes: gnome-shell.css
# wurde bei JEDEM ISO-Bau aus GNOMEs Basis-CSS und den ViperOS-Regeln
# zusammengesetzt, dazu entstanden index.theme und die GTK3/GTK4-Farben als
# Here-Docs. Auf einem installierten System liess sich davon nichts erneuern.
#
# Seit V2 liefert das Paket viperos-desktop-theme alles davon:
#
#   /usr/share/themes/ViperOS/gnome-shell/gnome-shell.css   (fertig gebaut)
#   /usr/share/themes/ViperOS/index.theme
#   /usr/share/backgrounds/viperos/*.jpg
#   /etc/skel/.config/gtk-{3,4}.0/gtk.css
#
# Zusammengesetzt wird beim PAKETBAU (packages/viperos-desktop-theme/debian/
# rules), nicht mehr hier. Das Paket bricht ab, wenn das Ergebnis unter
# 150 KB liegt.
#
# Dieser Hook prueft nur noch, dass das Paket wirklich im Image liegt. Ohne
# diese Kontrolle wuerde ein vergessenes Paket erst beim Booten auffallen -
# als Oberflaeche ohne Rundungen, weil GNOME sein Stylesheet nicht laedt,
# sobald ein eigenes gesetzt ist (Main.setThemeStylesheet).

set -e

echo "[ViperosOS] Pruefe Theme-Paket..."

CSS=/usr/share/themes/ViperOS/gnome-shell/gnome-shell.css

if [ ! -f "$CSS" ]; then
    echo "  FEHLER: $CSS fehlt."
    echo "  Ist viperos-desktop-theme in der Paketliste? Ohne das Theme"
    echo "  startet die Sitzung mit St-Voreinstellungen statt mit ViperOS."
    exit 1
fi

size=$(stat -c%s "$CSS")
echo "  gnome-shell.css: $size Bytes"

# Dieselbe Schwelle wie im Paketbau. Ein zu kleines Theme bedeutet, dass
# GNOMEs Basis-CSS fehlt - die Shell zeigt dann einen Balken ohne Rundung.
if [ "$size" -lt 150000 ]; then
    echo "  FEHLER: Theme ist nur $size Bytes - Basis-CSS fehlt."
    exit 1
fi

if [ -f /usr/share/themes/ViperOS/index.theme ]; then
    echo "  index.theme vorhanden (Theme erscheint in gnome-tweaks)"
else
    echo "  WARNUNG: index.theme fehlt - Theme ist nicht auswaehlbar"
fi

count=$(find /usr/share/backgrounds/viperos -type f \
          \( -name '*.jpg' -o -name '*.png' \) 2>/dev/null | wc -l)
echo "  Hintergrundbilder: $count"

# Der Live-Benutzer wurde in Hook 0010 angelegt, also VOR der Installation
# des Theme-Pakets. /etc/skel greift nur bei neu angelegten Konten, deshalb
# bekommt er die GTK-Farben hier nachtraeglich.
if id viperos >/dev/null 2>&1; then
    for v in 3.0 4.0; do
        src="/etc/skel/.config/gtk-$v/gtk.css"
        [ -f "$src" ] || continue
        mkdir -p "/home/viperos/.config/gtk-$v"
        cp "$src" "/home/viperos/.config/gtk-$v/gtk.css"
    done
    chown -R viperos:viperos /home/viperos/.config 2>/dev/null || true
    echo "  GTK-Farben fuer den Live-Benutzer uebernommen"
fi

echo "[ViperosOS] Theme-Paket in Ordnung."
