#!/bin/bash
# ViperosOS - GNOME-Shell-Theme zusammensetzen
#
# WICHTIG - das war zuvor falsch:
# Die user-theme-Extension ruft Main.setThemeStylesheet(pfad) auf. GNOME
# laedt sein eigenes Stylesheet nur, wenn KEINES gesetzt ist. Ein eigenes
# Theme ERSETZT also die kompletten 174 KB Standardregeln, es ergaenzt sie
# nicht. Ein 9-KB-Theme liess dadurch ~165 KB Regeln weg: Topbar, Menues
# und Uebersicht fielen auf St-Voreinstellungen zurueck - sichtbar als
# "nur ein Balken ohne Rundung".
#
# Richtig ist: GNOMEs Standard-CSS als Basis nehmen und die eigenen Regeln
# ANHAENGEN. Spaetere Regeln gewinnen in CSS, also ueberschreiben unsere
# genau das, was sie ansprechen - der Rest bleibt vollstaendig erhalten.
# Ubuntu macht es mit Yaru genauso; deshalb ist auch Yaru ~180 KB gross.
#
# gnome-shell-base.css und viperos-overrides.css kommen ueber
# includes.chroot ins Image; hier werden sie nur verbunden.

set -e

echo "[ViperosOS] Setze GNOME-Shell-Theme zusammen..."

THEME=/usr/share/themes/ViperOS/gnome-shell
BASE="$THEME/gnome-shell-base.css"
OVER="$THEME/viperos-overrides.css"
OUT="$THEME/gnome-shell.css"

if [ ! -f "$BASE" ]; then
    # Rueckfall: Basis aus dem installierten gnome-shell-common ziehen.
    echo "  gnome-shell-base.css fehlt - extrahiere aus gnome-shell-theme.gresource"
    G=/usr/share/gnome-shell/gnome-shell-theme.gresource
    if [ -f "$G" ] && command -v gresource >/dev/null 2>&1; then
        mkdir -p "$THEME"
        gresource extract "$G" /org/gnome/shell/theme/gnome-shell-dark.css > "$BASE"
        for svg in calendar-today.svg calendar-today-light.svg \
                   gnome-shell-start.svg workspace-placeholder.svg; do
            gresource extract "$G" "/org/gnome/shell/theme/$svg" > "$THEME/$svg" 2>/dev/null || true
        done
    else
        echo "  WARNUNG: weder Basis-CSS noch gresource verfuegbar"
    fi
fi

if [ -f "$BASE" ] && [ -f "$OVER" ]; then
    {
        cat "$BASE"
        printf '\n\n/* ==== ViperOS-Ueberschreibungen ab hier ==== */\n\n'
        cat "$OVER"
    } > "$OUT"
    echo "  gnome-shell.css erzeugt: $(stat -c%s "$OUT") Bytes"
    echo "    davon Basis:        $(stat -c%s "$BASE") Bytes"
    echo "    davon ViperOS:      $(stat -c%s "$OVER") Bytes"
else
    echo "  WARNUNG: Theme konnte nicht zusammengesetzt werden"
    [ -f "$BASE" ] || echo "    fehlt: $BASE"
    [ -f "$OVER" ] || echo "    fehlt: $OVER"
fi

# index.theme kennzeichnet das Verzeichnis als Theme; ohne sie taucht
# "ViperOS" in gnome-tweaks nicht in der Auswahl auf.
cat > /usr/share/themes/ViperOS/index.theme << 'EOF'
[Desktop Entry]
Type=X-GNOME-Metatheme
Name=ViperOS
Comment=Dunkles ViperOS-Erscheinungsbild
Encoding=UTF-8

[X-GNOME-Metatheme]
GtkTheme=Adwaita-dark
MetacityTheme=Adwaita
IconTheme=Papirus-Dark
CursorTheme=Adwaita
ButtonLayout=close,minimize,maximize:appmenu
EOF

# ----------------------------------------------------------------------
# GTK4/libadwaita-Anwendungen (Nautilus, Einstellungen, Textfenster)
# Deren Farben lassen sich nicht ueber ein Theme tauschen, wohl aber ueber
# @define-color in der Benutzer-CSS.
# ----------------------------------------------------------------------
mkdir -p /etc/skel/.config/gtk-4.0 /etc/skel/.config/gtk-3.0
cat > /etc/skel/.config/gtk-4.0/gtk.css << 'EOF'
/* ViperOS: libadwaita-Farben an das Shell-Theme angleichen */
@define-color accent_bg_color #6a8fd8;
@define-color accent_fg_color #0e1119;
@define-color accent_color #8fb0e8;
@define-color window_bg_color #12151f;
@define-color window_fg_color #e7eef9;
@define-color view_bg_color #1b1f2e;
@define-color view_fg_color #e7eef9;
@define-color headerbar_bg_color #1b1f2e;
@define-color headerbar_fg_color #e7eef9;
@define-color headerbar_border_color #22344f;
@define-color sidebar_bg_color #161a27;
@define-color sidebar_fg_color #e7eef9;
@define-color sidebar_border_color #22344f;
@define-color secondary_sidebar_bg_color #12151f;
@define-color card_bg_color #252b3d;
@define-color card_fg_color #e7eef9;
@define-color dialog_bg_color #1b1f2e;
@define-color dialog_fg_color #e7eef9;
@define-color popover_bg_color #1f2433;
@define-color popover_fg_color #e7eef9;
@define-color thumbnail_bg_color #1b1f2e;
@define-color shade_color rgba(0, 0, 0, 0.36);
@define-color scrollbar_outline_color rgba(106, 143, 216, 0.22);
EOF
cp /etc/skel/.config/gtk-4.0/gtk.css /etc/skel/.config/gtk-3.0/gtk.css

# Fuer den Live-Benutzer, der vor diesem Hook angelegt wurde.
if id viperos >/dev/null 2>&1; then
    mkdir -p /home/viperos/.config/gtk-4.0 /home/viperos/.config/gtk-3.0
    cp /etc/skel/.config/gtk-4.0/gtk.css /home/viperos/.config/gtk-4.0/gtk.css
    cp /etc/skel/.config/gtk-3.0/gtk.css /home/viperos/.config/gtk-3.0/gtk.css
    chown -R viperos:viperos /home/viperos/.config 2>/dev/null || true
fi

echo "[ViperosOS] Shell-Theme unter /usr/share/themes/ViperOS bereit."
