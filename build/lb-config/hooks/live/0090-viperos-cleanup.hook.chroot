#!/bin/bash
# ViperosOS - Cleanup & Abschluss-Konfigurationen

set -e

echo "[ViperosOS] Finale Konfiguration & Cleanup..."

# APT Cache leeren
apt-get clean
rm -rf /var/lib/apt/lists/*
rm -rf /tmp/*
rm -rf /var/tmp/*

# Locale generieren
locale-gen de_DE.UTF-8 en_US.UTF-8 2>/dev/null || true
update-locale LANG=de_DE.UTF-8 LC_ALL=de_DE.UTF-8 2>/dev/null || true

# Zeitzone
ln -sf /usr/share/zoneinfo/Europe/Berlin /etc/localtime 2>/dev/null || true
echo "Europe/Berlin" > /etc/timezone

# Keyboard Layout
cat > /etc/default/keyboard << 'EOF'
XKBMODEL="pc105"
XKBLAYOUT="de"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF

# Desktop-Shortcuts für Live-User
mkdir -p /home/viperos/Desktop
cp /etc/skel/Desktop/* /home/viperos/Desktop/ 2>/dev/null || true
chown -R viperos:viperos /home/viperos/ 2>/dev/null || true

# Systemd-Targets. Die Symlinks werden direkt gesetzt, weil systemctl im
# Chroot ohne laufenden systemd fehlschlaegt und "|| true" den Fehler
# verstecken wuerde (genau das hat den Ton gekostet, siehe Hook 0055).
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /lib/systemd/system/graphical.target /etc/systemd/system/default.target 2>/dev/null || \
  ln -sf /usr/lib/systemd/system/graphical.target /etc/systemd/system/default.target 2>/dev/null || true

for svc in NetworkManager bluetooth; do
    for base in /lib/systemd/system /usr/lib/systemd/system; do
        if [ -f "$base/$svc.service" ]; then
            ln -sf "$base/$svc.service" \
                   "/etc/systemd/system/multi-user.target.wants/$svc.service"
            break
        fi
    done
done
# GDM wird in Hook 0030 als display-manager.service verlinkt.

# Audio wird vollstaendig in 0055-viperos-audio eingerichtet.
# Frueher standen hier drei "systemctl --global enable"-Aufrufe. Ohne
# laufenden systemd im Chroot schlagen die fehl, und durch
# "2>/dev/null || true" blieb das unsichtbar - der Hook meldete Erfolg,
# die Units waren aber nie aktiviert. Nicht wieder aufnehmen: 0055 setzt
# die Symlinks direkt, was ohne systemd zuverlaessig funktioniert.

# Sprachpakete für Firefox
update-locale 2>/dev/null || true

# Zenity sicherstellen (für Welcome-Wizard)
which zenity || apt-get install -y zenity 2>/dev/null || true

echo "[ViperosOS] Finale Konfiguration abgeschlossen."
echo ""
echo "  ✓ ViperosOS 1.0 Build-Konfiguration komplett"
echo "  ✓ Live-User: viperos / viperos"
echo "  ✓ Desktop: GNOME Shell 48 mit ViperOS-Theme"
echo "  ✓ Browser: Firefox ESR"
echo "  ✓ Netzwerk: NetworkManager"
echo "  ✓ Login: GDM (Autologin im Live-Mode)"
echo "  ✓ Audio: PipeWire"
echo "  ✓ Installer: Calamares"
