#!/bin/bash
# ViperosOS - GDM als Anmeldemanager einrichten
#
# Das AUSSEHEN des Anmeldebildschirms liegt seit V2 im Paket
# viperos-settings (/etc/gdm3/greeter.dconf-defaults) und der Hintergrund im
# Paket viperos-desktop-theme (viperos-gdm.css). Hier bleibt nur, was das
# Live-Medium betrifft und nicht in ein Paket gehoert: welcher Dienst die
# grafische Anmeldung uebernimmt.
#
# Zur Greeter-Datenbank, damit das Wissen nicht verloren geht:
#
#   GDM benutzt eine DATEI-Datenbank, nicht /etc/dconf/db/gdm.d/:
#       /usr/share/dconf/profile/gdm:
#           user-db:user
#           file-db:/var/lib/gdm3/greeter-dconf-defaults
#
#   /usr/share/gdm/generate-config laeuft als ExecStartPre von gdm.service
#   und baut diese Datei bei JEDEM Start neu aus /usr/share/gdm/dconf/.
#   Einstellungen in /etc/dconf/db/gdm.d/ landen dort nie - der
#   Anmeldebildschirm blieb deshalb unveraendert. Richtig ist
#   /etc/gdm3/greeter.dconf-defaults: Debian verlinkt diese Datei als
#   /usr/share/gdm/dconf/90-debian-settings, sie wird also mitkompiliert.
#
# Autologin fuer die Live-Sitzung uebernimmt live-config (0080-gdm3).

set -e

echo "[ViperosOS] Richte GDM ein..."

# ----------------------------------------------------------------------
# Ein Ueberbleibsel aus aelteren Images entfernen.
#
# Lag /var/lib/gdm3/greeter-dconf-defaults als Datei mit falschen Rechten
# vor, scheiterte generate-config beim Umbenennen seiner temporaeren Datei
# ("Permission denied") - und mit dem ExecStartPre startete gdm.service
# nicht. generate-config legt das Verzeichnis selbst korrekt an:
#   install -m711 -oDebian-gdm -gDebian-gdm -d /var/lib/gdm3
# ----------------------------------------------------------------------
rm -f /var/lib/gdm3/greeter-dconf-defaults 2>/dev/null || true

# ----------------------------------------------------------------------
# GDM als Anmeldemanager eintragen. systemctl scheitert im Chroot ohne
# laufenden systemd, deshalb wird der Symlink direkt gesetzt.
# ----------------------------------------------------------------------
echo "/usr/sbin/gdm3" > /etc/X11/default-display-manager 2>/dev/null || true
mkdir -p /etc/systemd/system
for base in /lib/systemd/system /usr/lib/systemd/system; do
    if [ -f "$base/gdm3.service" ]; then
        ln -sf "$base/gdm3.service" /etc/systemd/system/display-manager.service
        echo "  display-manager.service -> gdm3"
        break
    fi
done

# Gegenpruefen, dass das Paket seine Greeter-Vorgaben mitgebracht hat.
if [ -f /etc/gdm3/greeter.dconf-defaults ]; then
    echo "  Greeter-Vorgaben vorhanden (aus viperos-settings)"
else
    echo "  WARNUNG: /etc/gdm3/greeter.dconf-defaults fehlt -"
    echo "  der Anmeldebildschirm erscheint in GNOMEs Standardoptik."
fi

echo "[ViperosOS] GDM eingerichtet."
