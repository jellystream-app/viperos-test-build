#!/bin/bash
# ViperosOS - Branding, Wallpaper, Logos

set -e

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

echo "[ViperosOS] Erstelle Branding-Assets..."

mkdir -p /usr/share/viperos

# --------------------------------------------------------
# Hintergrundbilder
#
# Die Bilder liegen als echte Dateien im Repository und werden ueber
# includes.chroot nach /usr/share/backgrounds/viperos/ kopiert - sie
# muessen hier also nicht erzeugt werden. Frueher stand an dieser Stelle
# ein Python-Skript, das einen Farbverlauf zeichnete; das ist durch die
# mitgelieferten Motive ersetzt.
#
# Sichtbar werden sie ueber:
#   /usr/share/gnome-background-properties/viperos.xml  (Einstellungen)
#   /etc/dconf/db/local.d/00-viperos                    (Standardbild)
# --------------------------------------------------------
mkdir -p /usr/share/pixmaps /usr/share/calamares/branding/viperos          /usr/share/icons/hicolor/scalable/apps /usr/share/viperos

if [ -d /usr/share/backgrounds/viperos ]; then
    count=$(find /usr/share/backgrounds/viperos -type f \( -name '*.jpg' -o -name '*.png' \) | wc -l)
    echo "  Hintergrundbilder gefunden: $count"
    # Symlink fuer Stellen, die einen festen Pfad erwarten (GRUB, Calamares).
    first=/usr/share/backgrounds/viperos/viperos-slate.jpg
    [ -f "$first" ] && ln -sf "$first" /usr/share/viperos/wallpaper.jpg
else
    echo "  WARNUNG: /usr/share/backgrounds/viperos fehlt"
fi

# --------------------------------------------------------
# Logo als SVG: skaliert verlustfrei auf jede Groesse, anders als die
# frueheren 96x96-PNGs (die auf HiDPI grob wirkten).
# --------------------------------------------------------
cat > /usr/share/icons/hicolor/scalable/apps/viperos.svg << 'SVGEOF'
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" width="192" height="192">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#101827"/>
      <stop offset="1" stop-color="#16233a"/>
    </linearGradient>
  </defs>
  <rect width="192" height="192" rx="34" fill="url(#bg)"/>
  <rect x="22" y="22" width="148" height="148" rx="28"
        fill="none" stroke="#55a5f7" stroke-width="8"/>
  <path d="M62 68 L96 132 L134 68" fill="none" stroke="#e7eef9"
        stroke-width="11" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
SVGEOF

# PNG-Ableitungen fuer Stellen, die kein SVG lesen (LightDM-Benutzerbild,
# Calamares-Branding). Aus dem SVG gerendert, daher in jeder Groesse scharf.
python3 << 'PYEOF' || echo "[ViperosOS] WARNUNG: Icon-Erzeugung fehlgeschlagen"
from PIL import Image, ImageDraw

def logo(size):
    s = size / 192.0
    img = Image.new('RGBA', (size, size), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    d.rounded_rectangle((0, 0, size - 1, size - 1), radius=int(34 * s), fill=(16, 24, 39, 255))
    d.rounded_rectangle((int(22 * s), int(22 * s), int(170 * s), int(170 * s)),
                        radius=int(28 * s), outline=(85, 165, 247, 255),
                        width=max(2, int(8 * s)))
    d.line((int(62 * s), int(68 * s), int(96 * s), int(132 * s), int(134 * s), int(68 * s)),
           fill=(231, 238, 249, 255), width=max(3, int(11 * s)), joint='curve')
    return img

# Grosse Quelle rendern und herunterskalieren: ergibt weiche Kanten
# statt der harten Treppen der frueheren Direktzeichnung.
base = logo(768)
for path, size in [
    ('/usr/share/viperos/user-icon.png', 256),
    ('/usr/share/pixmaps/viperos.png', 256),
    ('/usr/share/calamares/branding/viperos/viperos-icon.png', 256),
    ('/usr/share/calamares/branding/viperos/viperos-logo.png', 512),
]:
    base.resize((size, size), Image.LANCZOS).save(path, optimize=True)
print('Logos aus 768px-Quelle gerendert.')
PYEOF

# --------------------------------------------------------
# OS-Release Informationen
# --------------------------------------------------------
cat > /etc/os-release << 'EOF'
PRETTY_NAME="ViperosOS 1.0 (Trixie)"
NAME="ViperosOS"
VERSION_ID="1.0"
VERSION="1.0 (Viper)"
VERSION_CODENAME=viper
ID=viperos
ID_LIKE=debian
HOME_URL="https://viperos.os/"
SUPPORT_URL="https://viperos.os/support/"
BUG_REPORT_URL="https://viperos.os/bugs/"
LOGO=viperos-logo
EOF

# --------------------------------------------------------
# Issue & Motd
# --------------------------------------------------------
cat > /etc/issue << 'EOF'

  ViperosOS 1.0 - Based on Debian 13 (Trixie)
  \l

EOF

cp /etc/issue /etc/issue.net

cat > /etc/motd << 'EOF'

  Willkommen bei ViperosOS 1.0!

  Live-Benutzer: viperos  |  Passwort: viperos

EOF

# --------------------------------------------------------
# GRUB Bootmenü Design
# --------------------------------------------------------
mkdir -p /boot/grub/themes/viperos
cat > /etc/default/grub << 'EOF'
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="ViperOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_BACKGROUND="/usr/share/backgrounds/viperos/viperos-slate.jpg"
GRUB_GFXMODE="1920x1080,1280x720,auto"
GRUB_GFXPAYLOAD_LINUX=keep
EOF

echo "[ViperosOS] Branding erstellt."
