#!/bin/bash
# ViperosOS - Installer einrichten
#
# ----------------------------------------------------------------------
# Was in diesem Hook NICHT mehr steht
#
# Die Konfiguration des Installers liegt seit dieser Aenderung als echte
# Dateien im Repository, nicht mehr als Here-Docs hier:
#
#   includes.chroot/etc/calamares/settings.conf          Ablauf und Module
#   includes.chroot/etc/calamares/modules/*.conf         Einzelmodule
#   includes.chroot/usr/share/calamares/branding/viperos/ Erscheinungsbild
#
# Grund: als Text in einem Shell-Skript liess sich nichts davon pruefen. Die
# alte Fassung hatte zwei Fehler, die deshalb bis ins gebootete ISO kamen -
# ein Farbblock namens "colors:" statt "style:", und ein Kopierbefehl fuer
# /usr/share/calamares/branding/debian/, ein Verzeichnis, das es gar nicht
# gibt (Debian liefert sein Branding unter /etc/calamares/branding/). Beides
# scheiterte stumm. Als Datei im Repo prueft der Preflight sie jetzt als YAML.
#
# Hier bleibt nur, was sich nicht als Datei ablegen laesst: die beiden
# Bildchen werden erzeugt, und Debians Installer-Eintraege werden entfernt.
# ----------------------------------------------------------------------

set -e

echo "[ViperosOS] Richte Installer ein..."

brand_root=/usr/share/calamares/branding/viperos

# Gegenpruefen, dass die Konfiguration aus includes.chroot angekommen ist.
# Fehlt sie, startet Calamares mit Debians Vorgaben - ohne das
# removeuser-Modul, also mit einem Live-Konto, das die Installation
# ueberlebt. Das darf nicht stumm passieren.
for f in /etc/calamares/settings.conf \
         /etc/calamares/modules/removeuser.conf \
         "$brand_root/branding.desc"; do
    if [ ! -f "$f" ]; then
        echo "  FEHLER: $f fehlt."
        echo "  Wurde includes.chroot nach config/ kopiert? Siehe die"
        echo "  Kopierliste im Build-Workflow."
        exit 1
    fi
done
echo "  Konfiguration vorhanden (settings.conf, removeuser.conf, branding.desc)"

# ----------------------------------------------------------------------
# Logo und Symbol erzeugen
#
# Bleibt im Hook: es sind Binaerdateien, die sich aus wenigen Zeilen Code
# ableiten lassen. python3-pil steht dafuer in der Paketliste.
# ----------------------------------------------------------------------
mkdir -p "$brand_root"
python3 - << 'PYEOF'
from PIL import Image, ImageDraw
for name in ("viperos-icon.png", "viperos-logo.png"):
    image = Image.new("RGB", (192, 192), (16, 24, 39))
    draw = ImageDraw.Draw(image)
    draw.rounded_rectangle((22, 22, 170, 170), radius=28, outline=(85, 165, 247), width=8)
    draw.line((62, 68, 96, 132, 134, 68), fill=(231, 238, 249), width=10, joint="curve")
    image.save("/usr/share/calamares/branding/viperos/" + name)
PYEOF
echo "  Logo und Symbol erzeugt"

# ----------------------------------------------------------------------
# Hinweis: Authentication Agent
#
# "pkexec calamares" zeigt nur dann einen Passwortdialog, wenn in der
# Sitzung ein polkit-Agent laeuft. Unter XFCE fehlte einer, weshalb hier
# frueher lxpolkit samt eigenem Autostart eingerichtet wurde.
#
# Unter GNOME ist der Agent Teil der Shell: gnome-shell deklariert
# "Provides: polkit-1-auth-agent" und startet ihn mit der Sitzung. Ein
# zweiter Agent wuerde nur mit der Shell um die Registrierung am Systembus
# konkurrieren, deshalb wird hier keiner mehr eingerichtet.
#
# Calamares laeuft unter Wayland als X11-Client ueber XWayland; die
# polkit-Policy erlaubt das ausdruecklich (allow_gui=true).
# ----------------------------------------------------------------------

# Der Installer laeuft ueber pkexec; die Policy dafuer liefert calamares
# selbst (/usr/share/polkit-1/actions/com.github.calamares.calamares.policy).
cat > /usr/share/applications/viperos-installer.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=ViperOS installieren
Name[en]=Install ViperOS
Comment=ViperOS dauerhaft auf diesem Computer installieren
Comment[en]=Install ViperOS permanently on this computer
Exec=pkexec calamares
Icon=viperos
Terminal=false
Categories=System;Settings;
Keywords=install;installer;setup;calamares;
EOF

# ----------------------------------------------------------------------
# Debians eigenes Installer-Symbol unterdruecken
#
# calamares-settings-debian bringt zwei Dateien mit:
#   /usr/share/applications/calamares-install-debian.desktop
#   /etc/xdg/autostart/calamares-desktop-icon.desktop
# Die zweite ruft beim Sitzungsstart "add-calamares-desktop-icon" auf und
# legt damit ein Debian-Symbol auf den Schreibtisch. Genau das war im
# Screenshot als "calamares-install-debian..." mit Debian-Spirale zu sehen.
# ----------------------------------------------------------------------
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop
rm -f /usr/share/applications/calamares-install-debian.desktop
# calamares.desktop selbst ausblenden - wir haben unseren eigenen Eintrag.
if [ -f /usr/share/applications/calamares.desktop ]; then
    printf 'NoDisplay=true\n' >> /usr/share/applications/calamares.desktop
fi
echo "  Debian-Installersymbol entfernt"

# ----------------------------------------------------------------------
# Debians gschema-Override neutralisieren
#
# 96_calamares-settings-debian.gschema.override setzt favorite-apps auf
# Debians Liste - angefuehrt von calamares-install-debian.desktop, dazu
# evolution, rhythmbox, gnome-software und yelp, die gar nicht im Image
# sind. Leere Stellen im Dock waeren die Folge.
#
# Zur Einordnung, damit die Tragweite nicht ueberschaetzt wird: ViperOS
# setzt favorite-apps in der dconf-Systemdatenbank (viperos-settings,
# /etc/dconf/db/local.d/00-viperos), und die schlaegt jeden Schema-Default -
# eine gschema.override liefert nur den Wert, der gilt, wenn KEINE
# Datenbank im Profil etwas sagt (dconf(7): Profil-Datenbanken zuerst,
# Schema-Default zuletzt). Die Datei ist also bereits wirkungslos,
# solange die dconf-Vorgaben greifen.
#
# Sie wird trotzdem geleert, weil sie sonst als stille Zeitbombe liegen
# bleibt: faellt die dconf-Datenbank einmal aus - ein Typfehler verwirft
# die GANZE Datei, siehe der Hinweis in 00-viperos - traegt das Dock
# ploetzlich Debians Liste samt Verweis auf einen Installer, den das
# installierte System gar nicht mehr hat.
#
# Geleert statt geloescht: die Datei gehoert dpkg. Ein leerer Inhalt
# ueberlebt ein Paketupdate besser als ein fehlender Pfad. Dasselbe
# Vorgehen wie bei desktop-base in Hook 0065.
# ----------------------------------------------------------------------
gso=/usr/share/glib-2.0/schemas/96_calamares-settings-debian.gschema.override
if [ -f "$gso" ]; then
    : > "$gso"
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas/ >/dev/null 2>&1 || true
    fi
    echo "  Debians favorite-apps-Override geleert"
fi

# ----------------------------------------------------------------------
# Desktop-Verknuepfung fuer den ViperOS-Installer
#
# Damit "Desktop Icons NG" (ding) sie ohne Warnzeichen anzeigt, braucht
# es ZWEI Dinge: das Ausfuehrbar-Bit UND das Attribut metadata::trusted.
# Fehlt Letzteres, malt ding ein X ueber das Symbol - so wie im
# Screenshot zu sehen. Das Attribut liegt in der GIO-Metadatenbank des
# Benutzers, nicht in der Datei, und laesst sich im Chroot nicht setzen -
# deshalb erledigt das ein Autostart beim ersten Anmelden.
# ----------------------------------------------------------------------
for target in /etc/skel/Desktop /home/viperos/Desktop; do
    mkdir -p "$target"
    cp /usr/share/applications/viperos-installer.desktop "$target/"
    chmod 0755 "$target/viperos-installer.desktop"
done

mkdir -p /usr/local/bin /etc/xdg/autostart
cat > /usr/local/bin/viperos-trust-desktop << 'EOF'
#!/bin/sh
# Markiert die Verknuepfungen auf dem Schreibtisch als vertrauenswuerdig,
# damit "Desktop Icons NG" sie ohne Warnzeichen anzeigt.
set -u
command -v gio >/dev/null 2>&1 || exit 0
DESK="${XDG_DESKTOP_DIR:-$HOME/Desktop}"
[ -d "$DESK" ] || exit 0

for f in "$DESK"/*.desktop; do
    [ -f "$f" ] || continue
    chmod +x "$f" 2>/dev/null || true
    gio set "$f" "metadata::trusted" true 2>/dev/null || true
done

# ding liest die Metadaten beim Start; ein Neuladen macht die Aenderung
# sofort sichtbar, ohne Abmelden.
touch "$DESK" 2>/dev/null || true
exit 0
EOF
chmod 0755 /usr/local/bin/viperos-trust-desktop

cat > /etc/xdg/autostart/viperos-trust-desktop.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=ViperOS Desktop-Verknuepfungen
Comment=Markiert Verknuepfungen als vertrauenswuerdig
Exec=/usr/local/bin/viperos-trust-desktop
Icon=preferences-desktop
Terminal=false
NoDisplay=true
OnlyShowIn=GNOME;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Phase=Applications
EOF

chown -R viperos:viperos /home/viperos 2>/dev/null || true

echo "[ViperosOS] Installer eingerichtet."
