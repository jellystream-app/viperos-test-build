#!/bin/bash
set -e

brand_root=/usr/share/calamares/branding
mkdir -p "$brand_root/viperos"

if [ -d "$brand_root/debian" ]; then
    cp -a "$brand_root/debian/." "$brand_root/viperos/"
fi

python3 - << 'PYEOF'
from PIL import Image, ImageDraw
for name in ("viperos-icon.png", "viperos-logo.png"):
    image = Image.new("RGB", (192, 192), (16, 24, 39))
    draw = ImageDraw.Draw(image)
    draw.rounded_rectangle((22, 22, 170, 170), radius=28, outline=(85, 165, 247), width=8)
    draw.line((62, 68, 96, 132, 134, 68), fill=(231, 238, 249), width=10, joint="curve")
    image.save("/usr/share/calamares/branding/viperos/" + name)
PYEOF
cat > "$brand_root/viperos/branding.desc" << 'EOF'
---
componentName: viperos
welcomeStyleCalamares: true
welcomeExpandingLogo: true
strings:
    productName: ViperOS
    shortProductName: ViperOS
    version: 1.0
    shortVersion: 1.0
    versionedName: ViperOS 1.0
    shortVersionedName: ViperOS 1.0
    bootloaderEntryName: ViperOS
    productUrl: https://viperos.os/
    supportUrl: https://viperos.os/support/
    releaseNotesUrl: https://viperos.os/release-notes/
images:
    productLogo: viperos-logo.png
    productIcon: viperos-icon.png
colors:
    sidebarBackground: "#101827"
    sidebarText: "#e7eef9"
    sidebarTextSelect: "#ffffff"
    sidebarTextHighlight: "#55a5f7"
EOF

if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding: .*/branding: viperos/' /etc/calamares/settings.conf
fi

# ----------------------------------------------------------------------
# polkit-Authentication-Agent erzwingen
#
# "pkexec calamares" zeigt nur dann einen Passwortdialog, wenn in der
# Sitzung ein Authentication Agent laeuft. Ohne Agent passiert beim Klick
# auf "ViperOS installieren" GAR NICHTS - der Knopf wirkt kaputt.
#
# lxpolkit liefert zwar selbst einen Autostart, dieser enthaelt aber
#   NotShowIn=GNOME;KDE;MATE;LXQt;XFCE;Unity;X-Cinnamon;
# - XFCE ist ausdruecklich ausgeschlossen, weil dort normalerweise
# xfce-polkit einspringt. Das Paket gibt es in Trixie nicht mehr, also
# wird der Autostart hier durch eine eigene Fassung ohne NotShowIn
# ersetzt.
# ----------------------------------------------------------------------
mkdir -p /etc/xdg/autostart
cat > /etc/xdg/autostart/lxpolkit.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=PolicyKit Authentication Agent
Comment=Fragt nach Berechtigungen, wenn ein Programm Administratorrechte braucht
Exec=lxpolkit
TryExec=lxpolkit
Icon=gtk-dialog-authentication
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
OnlyShowIn=XFCE;
EOF

# Der Installer laeuft ueber pkexec; die Policy dafuer liefert calamares
# selbst (/usr/share/polkit-1/actions/com.github.calamares.calamares.policy).
cat > /usr/share/applications/viperos-installer.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=ViperOS installieren
Name[en]=Install ViperOS
Comment=ViperOS dauerhaft auf diesem Computer installieren
Comment[en]=Install ViperOS permanently on this computer
Exec=pkexec calamares
Icon=viperos
Terminal=false
Categories=System;Settings;
Keywords=install;installer;setup;calamares;
EOF

# Desktop-Verknuepfung, damit der Installer in der Live-Sitzung sofort
# sichtbar ist und nicht erst im Menue gesucht werden muss.
for target in /etc/skel/Desktop /home/viperos/Desktop; do
    mkdir -p "$target"
    cp /usr/share/applications/viperos-installer.desktop "$target/"
    chmod 0755 "$target/viperos-installer.desktop"
done
chown -R viperos:viperos /home/viperos 2>/dev/null || true
