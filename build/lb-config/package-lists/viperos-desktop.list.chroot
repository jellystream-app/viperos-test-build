# ============================================================
# ViperosOS - Paketliste (Debian 13 Trixie)
# Desktop: XFCE4 | Theme: Dark Glass | Apps: Dev + Media + Office
# ============================================================

# --- Basissystem & Sudo ---
sudo
bash-completion
curl
wget
ca-certificates
# gnupg2 war ein Transitional-Paket (Section: oldlibs) -> gnupg
gnupg
openssl
# apt-transport-https entfaellt: seit apt 1.5 im Kern enthalten
dbus-x11
# KRITISCH fuer den Ton: liefert die systemd-USER-Unit dbus.service.
# pipewire.service hat "Requires=pipewire.socket dbus.service"; fehlt die
# User-Unit, startet PipeWire nie und das System bleibt stumm. Das Paket
# "dbus" allein liefert nur die System-Unit, nicht die User-Unit.
dbus-user-session
# policykit-1 war transitional -> polkitd + pkexec
polkitd
pkexec
# Hinweis zum Authentication Agent (fuer "pkexec calamares"):
# Unter XFCE fehlte einer, deshalb stand hier lxpolkit. Unter GNOME ist er
# eingebaut - gnome-shell deklariert "Provides: polkit-1-auth-agent". Ein
# zweiter Agent wuerde sich mit der Shell um dieselbe Registrierung am
# Systembus streiten, deshalb ist lxpolkit hier bewusst NICHT eingetragen.

# --- Live-Boot (CRITICAL) ---
live-boot
live-config
live-config-systemd
live-tools
user-setup

# --- Hardware-Firmware ---
firmware-linux
firmware-linux-nonfree
firmware-amd-graphics
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-misc-nonfree
firmware-sof-signed
intel-microcode
amd64-microcode

# --- Secure Boot (ISO startet auch mit aktiviertem Secure Boot) ---
shim-signed
grub-efi-amd64-signed

# --- Display-Server ---
# Xorg bleibt trotz GNOME-auf-Wayland: XWayland braucht die Xorg-Bausteine,
# und der Calamares-Installer laeuft als X11-Client (siehe Hook 0040).
xorg
xserver-xorg
xserver-xorg-input-all
xwayland

# --- GNOME Shell (Struktur wie Fedora, Optik eigenstaendig) ---
gnome-shell
gnome-session
gnome-settings-daemon
gnome-control-center
gnome-terminal
nautilus
gnome-text-editor
gnome-system-monitor
gnome-disk-utility
gnome-tweaks
gnome-shell-extension-manager
# dconf-cli liefert "dconf update" - damit werden die systemweiten
# Vorgaben aus /etc/dconf/db/local.d/ kompiliert. Das ruft seit V2 die
# postinst von viperos-settings auf, nicht mehr ein Build-Hook.
dconf-cli
dconf-gsettings-backend
# Mutter braucht diese Daten; ohne sie startet die Shell nicht.
mutter-common
gsettings-desktop-schemas
gnome-themes-extra
# Portale fuer Flatpaks (Datei-Dialoge, Screenshots) unter GNOME
xdg-desktop-portal-gnome

# --- GNOME-Erweiterungen (aktiviert durch viperos-settings) ---
# dash-to-dock@micxgx.gmail.com        - Dock am unteren Rand
gnome-shell-extension-dashtodock
# ubuntu-appindicators@ubuntu.com      - Tray-Symbole (Discord, KeePassXC)
gnome-shell-extension-appindicator
# blur-my-shell@aunetx                 - Blur fuer Topbar und Uebersicht
gnome-shell-extension-blur-my-shell
# ding@rastersoft.com                  - Symbole auf dem Schreibtisch
gnome-shell-extension-desktop-icons-ng
# user-theme@...gcampax.github.com     - laedt /usr/share/themes/ViperOS
gnome-shell-extension-user-theme

# ============================================================
# --- ViperOS (eigene Pakete, seit V2) ---
#
# Ein Eintrag statt vieler Hook-Zeilen: das Metapaket zieht
#
#   viperos-settings          dconf-Vorgaben, Branding, Paketquelle
#   viperos-desktop-theme     Shell-Theme, Hintergruende, GTK-Farben
#   viperos-panel-extension   eigene Shell-Erweiterung
#   viperos-hub               Systemzentrale
#
# nach sich. Alles davon entstand bis V1 in den Build-Hooks und war nach der
# Installation eingefroren; jetzt kommt es aus dem ViperOS-Repo und laesst
# sich mit "apt upgrade" erneuern.
#
# Die Quelle dafuer traegt Hook 0005 ein, der VOR der Paketinstallation
# laeuft. Ist das Repository nicht erreichbar, bricht dieser Hook mit einer
# eindeutigen Meldung ab - nicht erst apt mit "Unable to locate package".
# ============================================================
viperos-desktop

# --- Login Manager ---
gdm3

# --- Browsers ---
firefox-esr

# --- Software & Developer Tools ---
nodejs
npm
git
python3
python3-pip
python3-venv
python3-pil
python3-gi
gir1.2-gtk-3.0

# --- Media & Design ---
vlc
gimp
flameshot
inkscape
audacity
obs-studio

# --- Office & Utilities ---
libreoffice-gtk3
libreoffice-calc
libreoffice-writer
libreoffice-impress
libreoffice-l10n-de

# --- Package Management ---
flatpak
xdg-desktop-portal-gtk

# --- Netzwerk ---
network-manager
network-manager-gnome
network-manager-openvpn
network-manager-openvpn-gnome
wireless-tools
wpasupplicant
rfkill
net-tools
iputils-ping
openssh-client
remmina
filezilla

# --- Bluetooth ---
bluez
blueman

# --- Audio (PipeWire ist der Standard-Stack in Trixie) ---
# pipewire-audio ist das Metapaket und zieht pipewire-pulse, pipewire-alsa,
# wireplumber und libspa-0.2-bluetooth zusammen.
pipewire
pipewire-audio
pipewire-pulse
pipewire-alsa
wireplumber
# Bluetooth-Audio (A2DP); ohne dieses Paket bleiben BT-Kopfhoerer stumm.
libspa-0.2-bluetooth
# Erlaubt PipeWire Echtzeit-Prioritaet - ohne rtkit knackst der Ton
# unter Last.
rtkit
pavucontrol
alsa-utils

# --- Security ---
apparmor
apparmor-utils
unattended-upgrades
ufw

# --- Fonts & Theming ---
fonts-dejavu
fonts-liberation
fonts-noto
fonts-noto-color-emoji
# Inter ist die Oberflaechenschrift von ViperOS (modern, gut lesbar in
# kleinen Groessen). Wird von viperos-settings als font-name gesetzt.
fonts-inter
# Monospace fuer Terminal und Editor
fonts-jetbrains-mono
# Adwaita ist unter GNOME das Basis-Icon-Theme; Papirus liegt darueber,
# damit Anwendungen ohne eigenes Adwaita-Symbol trotzdem passend aussehen.
adwaita-icon-theme
papirus-icon-theme

# --- Systemtools ---
gparted
htop
# neofetch existiert in Trixie nicht mehr (upstream unmaintained) -> fastfetch
fastfetch
# lspci: der ViperOS Hub liest darueber das Grafikmodell aus.
pciutils
keepassxc
file-roller
zip
unzip
p7zip-full
zenity
calamares
calamares-settings-debian
