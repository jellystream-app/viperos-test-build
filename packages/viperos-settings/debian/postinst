#!/bin/sh
# ViperOS Systemvorgaben - Nachbereitung der Installation
set -e

case "$1" in
configure)
    # ------------------------------------------------------------------
    # dconf-Datenbank kompilieren
    #
    # /etc/dconf/db/local.d/00-viperos ist Klartext; GNOME liest nur die
    # kompilierte Datei /etc/dconf/db/local. Ohne diesen Aufruf greift keine
    # einzige Vorgabe - der Desktop startet in GNOMEs Standardoptik.
    # ------------------------------------------------------------------
    if command -v dconf >/dev/null 2>&1; then
        dconf update || echo "viperos-settings: dconf update fehlgeschlagen" >&2
    fi

    # ------------------------------------------------------------------
    # GSettings-Schemata neu kompilieren
    #
    # 90_viperos.gschema.override setzt den Hintergrund gegen Debians
    # 10_desktop-base.gschema.override durch (90 gewinnt gegen 10). Wirksam
    # wird das erst nach dem Kompilieren.
    # ------------------------------------------------------------------
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas/ >/dev/null 2>&1 \
            || echo "viperos-settings: glib-compile-schemas fehlgeschlagen" >&2
    fi

    # ------------------------------------------------------------------
    # os-release
    #
    # Diese Datei wird NICHT als Paketdatei ausgeliefert: /usr/lib/os-release
    # gehoert dem Paket base-files. Zwei Pakete mit derselben Datei ergeben
    # einen dpkg-Dateikonflikt, und die Installation bricht ab. Deshalb wird
    # sie hier geschrieben.
    #
    # /etc/os-release ist ein Symlink auf ../usr/lib/os-release; geschrieben
    # wird die Zieldatei, damit beide Pfade stimmen.
    # ------------------------------------------------------------------
    cat > /usr/lib/os-release << 'OSEOF'
PRETTY_NAME="ViperOS 2.0 (Trixie)"
NAME="ViperOS"
VERSION_ID="2.0"
VERSION="2.0 (Viper)"
VERSION_CODENAME=viper
ID=viperos
ID_LIKE=debian
HOME_URL="https://radionet.app/"
SUPPORT_URL="https://radionet.app/"
BUG_REPORT_URL="https://github.com/jellystream-app/viperos-test-build/issues"
LOGO=viperos-logo
OSEOF
    # Falls /etc/os-release eine echte Datei ist statt eines Symlinks,
    # bliebe sie sonst auf dem alten Stand.
    if [ ! -L /etc/os-release ]; then
        cp /usr/lib/os-release /etc/os-release
    fi

    # ------------------------------------------------------------------
    # Distributions-Logo fuer den GNOME-"Ueber"-Dialog
    #
    # os-release verweist mit LOGO=viperos-logo auf ein Icon dieses Namens.
    # Debian legt sein Pendant unter icons/hicolor/SIZE/places/ ab - dem
    # folgen wir, sonst zeigt der Dialog gar nichts an.
    # ------------------------------------------------------------------
    if [ -f /usr/share/icons/hicolor/scalable/apps/viperos.svg ]; then
        mkdir -p /usr/share/icons/hicolor/scalable/places
        cp /usr/share/icons/hicolor/scalable/apps/viperos.svg \
           /usr/share/icons/hicolor/scalable/places/viperos-logo.svg
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
    fi

    # ------------------------------------------------------------------
    # Logo-Ableitungen als PNG
    #
    # Nicht jede Stelle liest SVG: Calamares-Branding und Benutzerbilder
    # brauchen PNG. Aus einer grossen Quelle herunterskaliert ergibt das
    # weiche Kanten statt harter Treppen.
    # ------------------------------------------------------------------
    if [ -f /usr/share/icons/hicolor/scalable/apps/viperos.svg ] \
       && command -v python3 >/dev/null 2>&1; then
        mkdir -p /usr/share/pixmaps /usr/share/viperos \
                 /usr/share/calamares/branding/viperos
        python3 - << 'PYEOF' 2>/dev/null || \
            echo "viperos-settings: PNG-Logos nicht erzeugt (python3-pil fehlt?)" >&2
from PIL import Image, ImageDraw

def logo(size):
    s = size / 192.0
    img = Image.new('RGBA', (size, size), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    d.rounded_rectangle((0, 0, size - 1, size - 1),
                        radius=int(34 * s), fill=(16, 24, 39, 255))
    d.rounded_rectangle((int(22 * s), int(22 * s), int(170 * s), int(170 * s)),
                        radius=int(28 * s), outline=(85, 165, 247, 255),
                        width=max(2, int(8 * s)))
    d.line((int(62 * s), int(68 * s), int(96 * s), int(132 * s),
            int(134 * s), int(68 * s)),
           fill=(231, 238, 249, 255), width=max(3, int(11 * s)), joint='curve')
    return img

base = logo(768)
for path, size in [
    ('/usr/share/viperos/user-icon.png', 256),
    ('/usr/share/pixmaps/viperos.png', 256),
    ('/usr/share/calamares/branding/viperos/viperos-icon.png', 256),
    ('/usr/share/calamares/branding/viperos/viperos-logo.png', 512),
]:
    base.resize((size, size), Image.LANCZOS).save(path, optimize=True)
PYEOF
    fi

    # ------------------------------------------------------------------
    # Firefox als ViperOS Browser
    #
    # /usr/share/applications/firefox-esr.desktop gehoert dem Paket
    # firefox-esr - als Paketdatei waere das ein dpkg-Dateikonflikt, genau
    # wie bei os-release. Deshalb wird die Datei hier geschrieben.
    #
    # Beim naechsten Update von firefox-esr ueberschreibt Debian sie wieder.
    # Das ist hingenommen: die Umbenennung ist kosmetisch, und ein
    # dpkg-divert waere der Preis eines dauerhaften Eingriffs in ein
    # fremdes Paket nicht wert.
    # ------------------------------------------------------------------
    if [ -f /usr/share/applications/firefox-esr.desktop ]; then
        sed -i \
            -e 's/^Name=.*/Name=ViperOS Browser/' \
            -e 's/^Name\[de\]=.*/Name[de]=ViperOS Browser/' \
            -e 's/^GenericName=.*/GenericName=ViperOS Web Browser/' \
            -e 's/^GenericName\[de\]=.*/GenericName[de]=ViperOS Webbrowser/' \
            /usr/share/applications/firefox-esr.desktop
    fi

    # Firefox als Standardbrowser. Die Alternativen existieren nur, wenn
    # firefox-esr installiert ist - daher ohne Abbruch bei Fehlschlag.
    if [ -x /usr/bin/firefox-esr ]; then
        update-alternatives --set x-www-browser /usr/bin/firefox-esr \
            >/dev/null 2>&1 || true
        update-alternatives --set gnome-www-browser /usr/bin/firefox-esr \
            >/dev/null 2>&1 || true
    fi

    # ------------------------------------------------------------------
    # Konsolen-Kennung
    # ------------------------------------------------------------------
    cat > /etc/issue << 'ISSUEEOF'

  ViperOS 2.0 - Based on Debian 13 (Trixie)
  \l

ISSUEEOF
    cp /etc/issue /etc/issue.net

    # ------------------------------------------------------------------
    # GRUB
    #
    # /etc/default/grub gehoert dem Paket grub-common und wird deshalb nur
    # bearbeitet, nicht ersetzt.
    # ------------------------------------------------------------------
    if [ -f /etc/default/grub ]; then
        if grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub; then
            sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="ViperOS"/' \
                /etc/default/grub
        else
            echo 'GRUB_DISTRIBUTOR="ViperOS"' >> /etc/default/grub
        fi
        # Hintergrundbild des Bootmenues, falls das Theme-Paket es liefert.
        BG=/usr/share/backgrounds/viperos/viperos-slate.jpg
        if [ -f "$BG" ] && ! grep -q '^GRUB_BACKGROUND=' /etc/default/grub; then
            echo "GRUB_BACKGROUND=\"$BG\"" >> /etc/default/grub
        fi
    fi
    ;;
esac

#DEBHELPER#

exit 0
